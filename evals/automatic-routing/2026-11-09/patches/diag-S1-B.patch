+#[test]
+fn list_and_watch_filters_validate_labels_and_never_hide_scan_warnings() {
+    let fixture = Fixture::new();
+    for view in ["list", "watch"] {
+        let output = fixture.human(&[view, "--help"]).output().unwrap();
+        assert!(output.status.success());
+        let text = String::from_utf8(output.stdout).unwrap();
+        let text = text.split_whitespace().collect::<Vec<_>>().join(" ");
+        assert!(text.contains("--owner <LABEL>"), "{text}");
+        assert!(text.contains("--task <LABEL>"), "{text}");
+        assert!(text.contains("declared owner label"), "{text}");
+        assert!(text.contains("not authorization"), "{text}");
+    }
+
+    let base = fixture.finished_template();
+    // Overdue history is collected by any listing, so while it remains, no
+    // listing has happened.
+    let overdue = "00000000d001";
+    fixture.seed_job(overdue, &base, ("o", Some("t")), "exited", 1, Some(1));
+    let long = "x".repeat(513);
+    // 257 characters, but 514 bytes: the limit is in bytes.
+    let wide = "é".repeat(257);
+    let invalid = [
+        long.as_str(),
+        wide.as_str(),
+        "a\nb",
+        "\t",
+        "\x1b[31m",
+        "\u{7f}",
+        "\u{85}",
+    ];
+    for value in invalid {
+        for flag in ["--owner", "--task"] {
+            for view in [
+                &["list", "--all", "--resources"][..],
+                &["watch", "--once", "--interval", "500ms"][..],
+            ] {
+                let args = joined(view, &[flag, value]);
+                let output = fixture.command(&args).output().unwrap();
+                assert_eq!(output.status.code(), Some(1), "{args:?}");
+                let error = parse(&output)["error"].as_str().unwrap().to_owned();
+                assert!(
+                    error.contains("at most 512 bytes without control characters"),
+                    "{args:?}: {error}"
+                );
+            }
+            for view in [&["list"][..], &["watch", "--once"][..]] {
+                let args = joined(view, &[flag, value]);
+                let output = fixture.human(&args).output().unwrap();
+                assert_eq!(output.status.code(), Some(1), "{args:?}");
+                assert!(output.stdout.is_empty(), "{args:?}: {}", describe(&output));
+                assert!(
+                    String::from_utf8_lossy(&output.stderr).contains("labels must be"),
+                    "{args:?}: {}",
+                    describe(&output)
+                );
+            }
+        }
+    }
+    // A refreshing watch also rejects an invalid label instead of looping.
+    let mut command = fixture.human(&["watch", "--task", "\x1b"]);
+    command
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null());
+    let mut watch = scopeguard_child(command.spawn().unwrap());
+    let status = wait(|| watch.0.try_wait().unwrap());
+    assert_eq!(status.code(), Some(1));
+    assert!(
+        fixture.state.join(overdue).exists(),
+        "an invalid filter listed or collected history"
+    );
+
+    // The boundary values are accepted. Retention is unchanged: a filtered
+    // listing collects overdue history even though it does not match.
+    let max = "x".repeat(512);
+    let max_wide = "é".repeat(256);
+    assert!(fixture.view_ids(&["list", "--owner", &max]).is_empty());
+    assert!(!fixture.state.join(overdue).exists());
+    let ids = fixture.view_ids(&["watch", "--once", "--task", &max_wide]);
+    assert!(ids.is_empty());
+
+    // An unreadable record could match any filter; its warning is kept.
+    let corrupt = "0000000000bb";
+    fixture.seed_files(corrupt, &[("record.json", b"not json".to_vec())]);
+    for args in [
+        &["list", "--owner", "nobody"][..],
+        &["list", "--all", "--resources", "--task", "t"][..],
+        &["watch", "--once", "--owner", "o", "--task", "t"][..],
+    ] {
+        let value = fixture.call(args);
+        assert_eq!(value["jobs"], serde_json::json!([]), "{args:?}");
+        assert!(
+            value["warnings"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|warning| warning.as_str().unwrap().starts_with(corrupt)),
+            "{args:?}: {value}"
+        );
+    }
+    for args in [
+        &["list", "--owner", "nobody"][..],
+        &["watch", "--once", "--task", "t"][..],
+    ] {
+        let output = fixture.human(args).output().unwrap();
+        assert!(output.status.success(), "{args:?}: {}", describe(&output));
+        assert!(
+            String::from_utf8_lossy(&output.stderr).contains(&format!("Warning: {corrupt}")),
+            "{args:?}: {}",
+            describe(&output)
+        );
+    }
+    fs::remove_dir_all(fixture.state.join(corrupt)).unwrap();
+}
