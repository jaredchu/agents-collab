+/// Exact, case-sensitive match of declared labels; filters combine with AND.
+/// A job without a task never matches a task filter.
+pub fn labels_match(record: &Record, owner: Option<&str>, task: Option<&str>) -> bool {
+    owner.is_none_or(|owner| record.owner == owner)
+        && task.is_none_or(|task| record.task.as_deref() == Some(task))
+}
