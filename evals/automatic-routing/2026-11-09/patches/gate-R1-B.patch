diff --git a/src/model.rs b/src/model.rs
index c3b93d3..b6afe15 100644
--- a/src/model.rs
+++ b/src/model.rs
@@ -174,6 +174,30 @@ pub fn extend_deadline(record: &mut Record, by_ms: u64) -> Result<()> {
 #[cfg(test)]
 mod tests {
     use super::*;
+
+    fn running_record() -> Record {
+        // Synthetic dates far in the future avoid depending on test execution time.
+        let created_at_ms = u64::MAX / 2;
+        let launch = Launch {
+            id: "test-lease".into(),
+            argv: vec!["test-command".into()],
+            cwd: PathBuf::from("/test"),
+            owner: "test".into(),
+            task: None,
+            name: None,
+            url: None,
+            key: None,
+            fingerprint: String::new(),
+            created_at_ms,
+            expires_at_ms: created_at_ms + 3_600_000,
+            grace_ms: 2_000,
+            log_limit_bytes: 1_024,
+        };
+        let mut record = Record::new(&launch);
+        record.state = State::Running;
+        record
+    }
+
     #[test]
     fn durations_are_bounded_and_explicit() {
         assert_eq!(duration_ms("2h").unwrap(), 7_200_000);
@@ -182,4 +206,69 @@ mod tests {
         assert!(duration_ms("25h").is_err());
         assert!(duration_ms("forever").is_err());
     }
+
+    #[test]
+    fn extension_adds_exactly_the_requested_duration_to_the_deadline() {
+        let mut record = running_record();
+        let original_deadline = record.expires_at_ms;
+        let by_ms = 250;
+
+        extend_deadline(&mut record, by_ms).unwrap();
+
+        assert_eq!(record.expires_at_ms, original_deadline + by_ms);
+    }
+
+    #[test]
+    fn extension_rejects_non_running_states_without_changing_the_deadline() {
+        for state in [
+            State::Starting,
+            State::Stopping,
+            State::Stopped,
+            State::Expired,
+            State::Exited,
+            State::Failed,
+            State::Interrupted,
+            State::Unknown,
+        ] {
+            let mut record = running_record();
+            record.state = state;
+            let original_deadline = record.expires_at_ms;
+
+            assert!(extend_deadline(&mut record, 250).is_err(), "{state:?}");
+            assert_eq!(record.expires_at_ms, original_deadline, "{state:?}");
+        }
+    }
+
+    #[test]
+    fn extension_rejects_an_expired_running_lease_without_changing_the_deadline() {
+        let mut record = running_record();
+        record.created_at_ms = 0;
+        record.expires_at_ms = 0;
+        let original_deadline = record.expires_at_ms;
+
+        assert!(extend_deadline(&mut record, 250).is_err());
+        assert_eq!(record.expires_at_ms, original_deadline);
+    }
+
+    #[test]
+    fn extension_rejects_zero_without_changing_the_deadline() {
+        let mut record = running_record();
+        let original_deadline = record.expires_at_ms;
+
+        assert!(extend_deadline(&mut record, 0).is_err());
+        assert_eq!(record.expires_at_ms, original_deadline);
+    }
+
+    #[test]
+    fn extension_accepts_exactly_24_hours_but_rejects_one_millisecond_more() {
+        let mut record = running_record();
+        let maximum_deadline = record.created_at_ms + 24 * 60 * 60 * 1_000;
+        let by_ms = maximum_deadline - record.expires_at_ms;
+
+        extend_deadline(&mut record, by_ms).unwrap();
+        assert_eq!(record.expires_at_ms, maximum_deadline);
+
+        assert!(extend_deadline(&mut record, 1).is_err());
+        assert_eq!(record.expires_at_ms, maximum_deadline);
+    }
 }
