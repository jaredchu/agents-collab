+#[test]
+fn logs_refuse_symlinked_output_in_human_and_json_modes() {
+    let fixture = Fixture::new();
+    let (record, launch) = fixture.finished_template();
+    let id = "0123456789ab";
+    fixture.seed_history(id, &record, &launch, now_ms());
+
+    let marker = "unrelated-file-marker-must-not-appear-in-logs";
+    let target = fixture.dir.path().join("marker.txt");
+    fs::write(&target, marker).unwrap();
+    let log = fixture.state.join(id).join("output.log");
+    fs::remove_file(&log).unwrap();
+    std::os::unix::fs::symlink(&target, &log).unwrap();
+
+    for json in [false, true] {
+        let mut command = Command::new(env!("CARGO_BIN_EXE_proclease"));
+        command.arg("--state-dir").arg(&fixture.state);
+        if json {
+            command.arg("--json");
+        }
+        let output = command.args(["logs", id]).output().unwrap();
+        assert!(
+            !String::from_utf8_lossy(&output.stdout).contains(marker)
+                && !String::from_utf8_lossy(&output.stderr).contains(marker),
+            "logs disclosed the symlink target (json={json})"
+        );
+        assert_eq!(output.status.code(), Some(1), "json={json}");
+        if json {
+            let error = parse(&output);
+            assert_eq!(error["schema_version"], 1);
+            assert!(error["error"].as_str().is_some_and(|s| !s.is_empty()));
+            assert!(error.get("lines").is_none());
+        } else {
+            assert!(output.stdout.is_empty());
+            assert!(!output.stderr.is_empty());
+        }
+    }
+}
