+#[test]
+fn filtered_views_only_read_state_and_preserve_unfiltered_output() {
+    use std::{io::Read, os::unix::net::UnixListener};
+    let fixture = Fixture::new();
+    fixture.call(&["list"]);
+    fixture.seed_view_record("000000000001", "a", Some("t"), "failed", Some(now_ms()));
+    for view in [&["list"][..], &["watch", "--once"][..]] {
+        let filtered = [view, &["--owner", "a", "--task", "t"]].concat();
+        assert_eq!(fixture.call(view), fixture.call(&filtered));
+        let plain = fixture.human_view(view);
+        let scoped = fixture.human_view(&filtered);
+        assert!(plain.status.success() && scoped.status.success());
+        assert_eq!(plain.stdout, scoped.stdout);
+        assert_eq!(plain.stderr, scoped.stderr);
+    }
+    // Both matching and unrelated history would be eligible for collection.
+    fixture.seed_view_record("000000000002", "a", Some("t"), "failed", Some(1));
+    fixture.seed_view_record("000000000003", "b", Some("other"), "failed", Some(1));
+    fixture.seed_view_record("000000000004", "a", Some("t"), "running", None);
+    let listener = UnixListener::bind(fixture.state.join("000000000004/ctl.sock")).unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let paths: Vec<_> = (1..=4)
+        .map(|i| fixture.state.join(format!("{i:012x}/record.json")))
+        .collect();
+    let before: Vec<_> = paths.iter().map(|p| fs::read(p).unwrap()).collect();
+    for view in [
+        &["list"][..],
+        &["watch", "--once", "--interval", "200ms"][..],
+    ] {
+        for filters in [
+            &["--owner", "a"][..],
+            &["--task", "t"][..],
+            &["--owner", "absent", "--task", "t"][..],
+        ] {
+            let args = [view, filters, &["--all", "--resources"]].concat();
+            fixture.call(&args);
+            assert!(fixture.human_view(&args).status.success());
+        }
+    }
+    assert_eq!(
+        before,
+        paths
+            .iter()
+            .map(|p| fs::read(p).unwrap())
+            .collect::<Vec<_>>()
+    );
+    // Availability probes may connect, but no Stop or Extend request is sent.
+    let mut probes = 0;
+    loop {
+        match listener.accept() {
+            Ok((mut stream, _)) => {
+                stream.set_nonblocking(true).unwrap();
+                let mut request = Vec::new();
+                stream.read_to_end(&mut request).unwrap();
+                assert!(request.is_empty());
+                probes += 1;
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => break,
+            Err(error) => panic!("{error}"),
+        }
+    }
+    assert!(probes > 0);
+    drop(listener);
+    fs::remove_dir_all(fixture.state.join("000000000004")).unwrap();
+}
