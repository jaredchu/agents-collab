+impl Fixture {
+    /// View fixtures need no supervisors or launch: seed only declared state.
+    fn seed_view_record(
+        &self,
+        id: &str,
+        owner: &str,
+        task: Option<&str>,
+        state: &str,
+        finished: Option<u64>,
+    ) {
+        let record = serde_json::json!({
+            "schema_version": 1, "id": id, "argv": ["/usr/bin/true"],
+            "cwd": "/", "owner": owner, "task": task, "name": null, "url": null,
+            "created_at_ms": 1, "expires_at_ms": 30_001, "state": state,
+            "reason": "launch_failed", "keeper_pid": 0, "guardian_pid": null,
+            "command_pid": null, "exit_code": null, "finished_at_ms": finished,
+            "log_limit_bytes": 1_048_576, "logs_truncated": false, "error": null
+        });
+        self.seed_files(id, &[("record.json", serde_json::to_vec(&record).unwrap())]);
+    }
+
+    fn human_view(&self, args: &[&str]) -> Output {
+        Command::new(env!("CARGO_BIN_EXE_proclease"))
+            .arg("--state-dir")
+            .arg(&self.state)
+            .args(["--color", "never"])
+            .args(args)
+            .env("COLUMNS", "120")
+            .output()
+            .unwrap()
+    }
+}
+
+fn view_ids(value: &Value) -> Vec<&str> {
+    let mut ids: Vec<_> = value["jobs"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|job| job["id"].as_str().unwrap())
+        .collect();
+    ids.sort_unstable();
+    ids
+}
