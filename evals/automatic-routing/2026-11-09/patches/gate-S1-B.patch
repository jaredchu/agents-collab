+#[test]
+fn filtered_views_select_before_the_recent_window_and_keep_matching_unverified_and_active_jobs() {
+    use std::os::unix::net::UnixListener;
+    let fixture = Fixture::new();
+    fixture.call(&["list"]);
+    let now = now_ms();
+    for i in 1..=8 {
+        fixture.seed_view_record(
+            &format!("{i:012x}"),
+            "a",
+            Some("t"),
+            "failed",
+            Some(now - 1_000 - i),
+        );
+        fixture.seed_view_record(
+            &format!("{:012x}", i + 16),
+            "b",
+            Some("t"),
+            "failed",
+            Some(now - i),
+        );
+    }
+    for (id, owner, state, finished) in [
+        ("fffffffffff1", "a", "running", None),
+        ("fffffffffff2", "a", "unknown", Some(1)),
+        ("fffffffffff3", "a", "failed", None),
+        ("fffffffffff4", "a", "failed", Some(now - 60_000)),
+        ("fffffffffff5", "b", "running", None),
+        ("fffffffffff6", "b", "unknown", None),
+    ] {
+        fixture.seed_view_record(id, owner, Some("t"), state, finished);
+    }
+    // A successful connect keeps seeded running records active without a process.
+    let matching = UnixListener::bind(fixture.state.join("fffffffffff1/ctl.sock")).unwrap();
+    let other = UnixListener::bind(fixture.state.join("fffffffffff5/ctl.sock")).unwrap();
+    for view in [&["list"][..], &["watch", "--once"][..]] {
+        let args = [view, &["--owner", "a", "--task", "t"]].concat();
+        let value = fixture.call(&args);
+        assert_eq!(
+            view_ids(&value),
+            [
+                "000000000001",
+                "000000000002",
+                "000000000003",
+                "000000000004",
+                "000000000005",
+                "fffffffffff1",
+                "fffffffffff2",
+                "fffffffffff3"
+            ]
+        );
+        let all = fixture.call(&[args.as_slice(), &["--all"]].concat());
+        assert_eq!(all["jobs"].as_array().unwrap().len(), 12);
+        assert!(all["jobs"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .all(|j| j["owner"] == "a"));
+        assert!(all["jobs"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|j| j["state"] == "running"));
+    }
+    drop((matching, other));
+    // Never ask fixture teardown to control synthetic running jobs.
+    fs::remove_dir_all(fixture.state.join("fffffffffff1")).unwrap();
+    fs::remove_dir_all(fixture.state.join("fffffffffff5")).unwrap();
+}
