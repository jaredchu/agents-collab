+#[test]
+fn filtered_views_match_exact_declared_labels_with_and_and_optional_tasks() {
+    let fixture = Fixture::new();
+    fixture.call(&["list"]); // Create a private state root, without launching.
+    for (id, owner, task) in [
+        ("000000000001", "Owner", Some("Task")),
+        ("000000000002", "Owner", Some("Other")),
+        ("000000000003", "owner", Some("Task")),
+        ("000000000004", "Owner", None),
+        ("000000000005", "", Some("")),
+    ] {
+        fixture.seed_view_record(id, owner, task, "failed", Some(now_ms()));
+    }
+    for view in [
+        &["list"][..],
+        &["watch", "--once", "--interval", "200ms"][..],
+    ] {
+        for (filters, expected) in [
+            (
+                vec!["--owner", "Owner"],
+                vec!["000000000001", "000000000002", "000000000004"],
+            ),
+            (vec!["--task", "Task"], vec!["000000000001", "000000000003"]),
+            (
+                vec!["--owner", "Owner", "--task", "Task"],
+                vec!["000000000001"],
+            ),
+            (vec!["--owner", "owner"], vec!["000000000003"]),
+            (vec!["--owner", "Ow"], vec![]),
+            (vec!["--task", "Ta"], vec![]),
+            (vec!["--task", "task"], vec![]),
+            (vec!["--task", ""], vec!["000000000005"]),
+            (vec!["--owner", "owner", "--task", "Other"], vec![]),
+            (vec!["--owner", "", "--task", ""], vec!["000000000005"]),
+        ] {
+            let args = [view, &["--all", "--resources"], &filters].concat();
+            let value = fixture.call(&args);
+            assert_eq!(view_ids(&value), expected, "{args:?}: {value}");
+            assert!(value["jobs"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .all(|j| j["resources"].is_null()));
+            assert_eq!(value["warnings"], serde_json::json!([]));
+        }
+    }
+}
