+#[test]
+fn filtered_views_validate_labels_before_output_and_preserve_scan_warnings() {
+    let fixture = Fixture::new();
+    fixture.call(&["list"]);
+    let boundary = "é".repeat(256); // 512 bytes, rather than 512 characters.
+    fixture.seed_view_record(
+        "000000000001",
+        &boundary,
+        Some(&boundary),
+        "failed",
+        Some(now_ms()),
+    );
+    let corrupt = "000000000002";
+    fixture.seed_files(corrupt, &[("record.json", b"not json".to_vec())]);
+    for view in [&["list"][..], &["watch", "--once"][..]] {
+        for flag in ["--owner", "--task"] {
+            for invalid in [
+                "x".repeat(513),
+                "é".repeat(257),
+                "bad\nlabel".into(),
+                "bad\u{7f}".into(),
+                "bad\u{85}".into(),
+            ] {
+                let args = [view, &[flag, &invalid]].concat();
+                let output = fixture.command(&args).output().unwrap();
+                assert_eq!(output.status.code(), Some(1), "{args:?}");
+                let value = parse(&output);
+                assert!(value["error"].as_str().unwrap().contains("labels must be"));
+                assert!(value.get("jobs").is_none());
+                assert_eq!(String::from_utf8_lossy(&output.stdout).lines().count(), 1);
+                let human = fixture.human_view(&args);
+                assert_eq!(human.status.code(), Some(1));
+                assert!(human.stdout.is_empty());
+                assert!(String::from_utf8_lossy(&human.stderr).contains("labels must be"));
+            }
+            let value = fixture.call(&[view, &[flag, &boundary]].concat());
+            assert_eq!(view_ids(&value), ["000000000001"]);
+        }
+        let args = [view, &["--owner", "nobody", "--task", "missing"]].concat();
+        let value = fixture.call(&args);
+        assert!(view_ids(&value).is_empty());
+        assert!(value["warnings"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|w| w.as_str().unwrap().contains(corrupt)));
+        let human = fixture.human_view(&args);
+        assert!(human.status.success());
+        assert!(String::from_utf8_lossy(&human.stderr).contains(corrupt));
+    }
+}
