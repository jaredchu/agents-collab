diff --git a/src/model.rs b/src/model.rs
index c3b93d3..037f04a 100644
--- a/src/model.rs
+++ b/src/model.rs
@@ -174,6 +174,29 @@ pub fn extend_deadline(record: &mut Record, by_ms: u64) -> Result<()> {
 #[cfg(test)]
 mod tests {
     use super::*;
+
+    fn running_lease() -> Record {
+        // Synthetic future timestamps avoid dependence on test execution time.
+        let created_at_ms = u64::MAX / 2;
+        let mut record = Record::new(&Launch {
+            id: "test-lease".into(),
+            argv: vec!["test-command".into()],
+            cwd: PathBuf::from("/test"),
+            owner: "test".into(),
+            task: None,
+            name: None,
+            url: None,
+            key: None,
+            fingerprint: String::new(),
+            created_at_ms,
+            expires_at_ms: created_at_ms + 60_000,
+            grace_ms: 0,
+            log_limit_bytes: 0,
+        });
+        record.state = State::Running;
+        record
+    }
+
     #[test]
     fn durations_are_bounded_and_explicit() {
         assert_eq!(duration_ms("2h").unwrap(), 7_200_000);
@@ -182,4 +205,76 @@ mod tests {
         assert!(duration_ms("25h").is_err());
         assert!(duration_ms("forever").is_err());
     }
+
+    #[test]
+    fn extension_adds_exactly_the_requested_duration() {
+        let mut record = running_lease();
+        let original_deadline = record.expires_at_ms;
+
+        extend_deadline(&mut record, 1_234).unwrap();
+
+        assert_eq!(record.expires_at_ms, original_deadline + 1_234);
+    }
+
+    #[test]
+    fn extension_rejects_non_running_states_without_changing_deadline() {
+        for state in [
+            State::Starting,
+            State::Stopping,
+            State::Stopped,
+            State::Expired,
+            State::Exited,
+            State::Failed,
+            State::Interrupted,
+            State::Unknown,
+        ] {
+            let mut record = running_lease();
+            record.state = state;
+            let original_deadline = record.expires_at_ms;
+
+            assert!(extend_deadline(&mut record, 1_000).is_err(), "{state:?}");
+            assert_eq!(record.expires_at_ms, original_deadline, "{state:?}");
+        }
+    }
+
+    #[test]
+    fn extension_rejects_expired_running_lease_without_changing_deadline() {
+        let mut record = running_lease();
+        record.created_at_ms = 0;
+        record.expires_at_ms = 0;
+
+        assert!(extend_deadline(&mut record, 1_000).is_err());
+        assert_eq!(record.expires_at_ms, 0);
+    }
+
+    #[test]
+    fn extension_rejects_zero_without_changing_deadline() {
+        let mut record = running_lease();
+        let original_deadline = record.expires_at_ms;
+
+        assert!(extend_deadline(&mut record, 0).is_err());
+        assert_eq!(record.expires_at_ms, original_deadline);
+    }
+
+    #[test]
+    fn extension_accepts_deadline_exactly_24_hours_after_creation() {
+        let mut record = running_lease();
+        let max_deadline = record.created_at_ms + 24 * 60 * 60 * 1_000;
+        let by_ms = max_deadline - record.expires_at_ms;
+
+        extend_deadline(&mut record, by_ms).unwrap();
+
+        assert_eq!(record.expires_at_ms, max_deadline);
+    }
+
+    #[test]
+    fn extension_rejects_deadline_one_millisecond_over_24_hours_without_changing_it() {
+        let mut record = running_lease();
+        let original_deadline = record.expires_at_ms;
+        let max_deadline = record.created_at_ms + 24 * 60 * 60 * 1_000;
+        let by_ms = max_deadline + 1 - original_deadline;
+
+        assert!(extend_deadline(&mut record, by_ms).is_err());
+        assert_eq!(record.expires_at_ms, original_deadline);
+    }
 }
