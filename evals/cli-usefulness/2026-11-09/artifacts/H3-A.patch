+++ b/tests/test_supported_version.py
@@ -0,0 +1,105 @@
+"""CLI coverage for querying the supported profile version without profile I/O."""
+
+import contextlib
+import importlib.util
+import io
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+
+PACKAGE = Path(__file__).resolve().parent.parent / "skills" / "agents-collab"
+SCRIPT = PACKAGE / "scripts" / "validate_profile.py"
+EXAMPLE = PACKAGE / "examples" / "profile.example.json"
+
+_previous_flag = sys.dont_write_bytecode
+sys.dont_write_bytecode = True
+try:
+    _spec = importlib.util.spec_from_file_location("supported_version_validator", SCRIPT)
+    vp = importlib.util.module_from_spec(_spec)
+    _spec.loader.exec_module(vp)
+finally:
+    sys.dont_write_bytecode = _previous_flag
+
+
+class SupportedVersion(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-I", "-B", str(SCRIPT), *args],
+            capture_output=True, timeout=10,
+        )
+
+    def test_option_alone_prints_exact_version(self):
+        result = self.run_cli("--print-supported-version")
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, b"1\n")
+        self.assertEqual(result.stderr, b"")
+
+    def test_option_uses_constant_and_never_reads_profile(self):
+        stdout, stderr = io.StringIO(), io.StringIO()
+        with mock.patch.object(vp, "SUPPORTED_VERSION", 42), \
+                mock.patch.object(vp, "read_profile_text") as reader, \
+                contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            self.assertEqual(vp.main(["--print-supported-version"]), 0)
+        reader.assert_not_called()
+        self.assertEqual(stdout.getvalue(), "42\n")
+        self.assertEqual(stderr.getvalue(), "")
+
+    def test_conflict_with_missing_path_is_usage_error_in_either_order(self):
+        with tempfile.TemporaryDirectory(prefix="agents-collab-version-") as tmp:
+            missing = str(Path(tmp) / "missing.json")
+            for args in (("--print-supported-version", missing),
+                         (missing, "--print-supported-version")):
+                with self.subTest(args=args):
+                    result = self.run_cli(*args)
+                    self.assertEqual(result.returncode, 2)
+                    self.assertEqual(result.stdout, b"")
+                    self.assertIn(b"usage:", result.stderr)
+                    self.assertIn(b"cannot be used with a profile", result.stderr)
+
+    def test_conflict_never_reads_any_positional_profile(self):
+        for path in (str(EXAMPLE), "missing.json", ""):
+            with self.subTest(path=path), \
+                    mock.patch.object(vp, "read_profile_text") as reader, \
+                    contextlib.redirect_stdout(io.StringIO()) as stdout, \
+                    contextlib.redirect_stderr(io.StringIO()) as stderr:
+                with self.assertRaises(SystemExit) as raised:
+                    vp.main(["--print-supported-version", path])
+                self.assertEqual(raised.exception.code, 2)
+                self.assertEqual(stdout.getvalue(), "")
+                self.assertIn("usage:", stderr.getvalue())
+                reader.assert_not_called()
+
+    def test_no_arguments_remains_usage_error(self):
+        result = self.run_cli()
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stdout, b"")
+        self.assertIn(b"usage:", result.stderr)
+
+    def test_help_succeeds_and_lists_option(self):
+        result = self.run_cli("--help")
+        self.assertEqual(result.returncode, 0)
+        self.assertIn(b"--print-supported-version", result.stdout)
+        self.assertEqual(result.stderr, b"")
+
+    def test_ordinary_valid_profile_still_validates(self):
+        result = self.run_cli(str(EXAMPLE))
+        self.assertEqual(result.returncode, 0)
+        self.assertIn(b"valid v1 profile structure", result.stdout)
+        self.assertEqual(result.stderr, b"")
+
+    def test_ordinary_invalid_profile_still_fails(self):
+        with tempfile.TemporaryDirectory(prefix="agents-collab-version-") as tmp:
+            path = Path(tmp) / "invalid.json"
+            path.write_text("{}", encoding="utf-8")
+            result = self.run_cli(str(path))
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, b"")
+        self.assertIn(b"version: missing required key", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
