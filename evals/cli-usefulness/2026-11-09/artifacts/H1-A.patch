+def _print_json_diagnostics(valid: Optional[bool], issues: List[Issue]) -> None:
+    """Serialize diagnostics without echoing rejected profile values."""
+    json_issues = []
+    for issue in issues:
+        message = issue.message
+        # The legacy API/human diagnostic includes the rejected numeric version.
+        # Keep that interface unchanged while omitting the value from JSON.
+        if issue.path == "version" and message.startswith("unsupported schema version "):
+            message = (f"unsupported schema version; only {SUPPORTED_VERSION} is supported, "
+                       "other fields were not interpreted")
+        json_issues.append({"path": issue.path, "message": message})
+    print(json.dumps({
+        "schema_version": 1,
+        "valid": valid,
+        "issues": json_issues,
+        "scope": "structure-only",
+    }))
+
