index 0000000..2733ffa
--- /dev/null
+++ b/tests/test_supported_version.py
@@ -0,0 +1,102 @@
+"""CLI contract for querying the validator's supported profile version."""
+
+import contextlib
+import importlib.util
+import io
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+
+PACKAGE = Path(__file__).resolve().parent.parent / "skills" / "agents-collab"
+SCRIPT = PACKAGE / "scripts" / "validate_profile.py"
+EXAMPLE = PACKAGE / "examples" / "profile.example.json"
+
+_previous_flag = sys.dont_write_bytecode
+sys.dont_write_bytecode = True
+try:
+    _spec = importlib.util.spec_from_file_location("supported_version_validator", SCRIPT)
+    vp = importlib.util.module_from_spec(_spec)
+    _spec.loader.exec_module(vp)
+finally:
+    sys.dont_write_bytecode = _previous_flag
+
+
+class SupportedVersion(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory(prefix="agents-collab-version-")
+        self.addCleanup(self._tmp.cleanup)
+        self.tmp = Path(self._tmp.name)
+
+    def run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-I", "-B", str(SCRIPT), *args],
+            cwd=str(self.tmp), capture_output=True, text=True, timeout=10,
+        )
+
+    def test_option_alone_prints_exact_version(self):
+        result = self.run_cli("--print-supported-version")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, "1\n")
+        self.assertEqual(result.stderr, "")
+        self.assertEqual(list(self.tmp.iterdir()), [])
+
+    def test_version_comes_from_constant_without_reading_a_profile(self):
+        stdout, stderr = io.StringIO(), io.StringIO()
+        with mock.patch.object(vp, "SUPPORTED_VERSION", 73), \
+                mock.patch.object(vp, "read_profile_text") as read, \
+                contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            code = vp.main(["--print-supported-version"])
+        self.assertEqual(code, 0)
+        self.assertEqual(stdout.getvalue(), "73\n")
+        self.assertEqual(stderr.getvalue(), "")
+        read.assert_not_called()
+
+    def test_conflict_with_missing_path_is_usage_error_in_either_order(self):
+        missing = str(self.tmp / "missing.json")
+        for args in (("--print-supported-version", missing),
+                     (missing, "--print-supported-version")):
+            with self.subTest(args=args):
+                result = self.run_cli(*args)
+                self.assertEqual(result.returncode, 2)
+                self.assertEqual(result.stdout, "")
+                self.assertIn("usage:", result.stderr)
+                self.assertIn("cannot be combined", result.stderr)
+                stdout, stderr = io.StringIO(), io.StringIO()
+                with mock.patch.object(vp, "read_profile_text") as read, \
+                        contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+                    with self.assertRaises(SystemExit) as raised:
+                        vp.main(list(args))
+                self.assertEqual(raised.exception.code, 2)
+                self.assertEqual(stdout.getvalue(), "")
+                read.assert_not_called()
+
+    def test_no_arguments_remains_usage_error(self):
+        result = self.run_cli()
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stdout, "")
+        self.assertIn("usage:", result.stderr)
+        self.assertIn("profile", result.stderr)
+
+    def test_help_remains_successful(self):
+        result = self.run_cli("--help")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("--print-supported-version", result.stdout)
+        self.assertEqual(result.stderr, "")
+
+    def test_ordinary_profile_validation_remains_successful(self):
+        profile = self.tmp / "profile.json"
+        original = EXAMPLE.read_bytes()
+        profile.write_bytes(original)
+        result = self.run_cli(str(profile))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("valid v1 profile structure", result.stdout)
+        self.assertEqual(result.stderr, "")
+        self.assertEqual(profile.read_bytes(), original)
+
+
+if __name__ == "__main__":
+    unittest.main()
