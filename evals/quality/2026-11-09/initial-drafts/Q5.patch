+/// Aggregate counts by summary category. Holds no per-job data.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+struct Counts {
+    active: usize,
+    unverified: usize,
+    finished: usize,
+}
+
+impl Counts {
+    fn of(jobs: &[Record]) -> Self {
+        let mut counts = Self::default();
+        for job in jobs {
+            match job.category() {
+                model::Category::Active => counts.active += 1,
+                model::Category::Unverified => counts.unverified += 1,
+                model::Category::Finished => counts.finished += 1,
+            }
+        }
+        counts
+    }
+    fn total(self) -> usize {
+        self.active + self.unverified + self.finished
+    }
+    fn json(self) -> serde_json::Value {
+        json!({"total": self.total(), "active": self.active,
+            "unverified": self.unverified, "finished": self.finished})
+    }
+    fn line(self, label: &str) -> String {
+        format!(
+            "{label}: {} (active {}, unverified {}, finished {})",
+            self.total(),
+            self.active,
+            self.unverified,
+            self.finished
+        )
+    }
+}
+
+/// Counts for `list --summary`: the same scan and selection as `list`, with
+/// `retained` taken before the default recent-window selection is applied.
+fn summary_counts(store: &Store, all: bool) -> Result<(Counts, Counts, Vec<String>)> {
+    let (mut jobs, warnings) = retained_jobs(store)?;
+    let retained = Counts::of(&jobs);
+    select_visible(&mut jobs, all, now_ms());
+    Ok((Counts::of(&jobs), retained, warnings))
+}
