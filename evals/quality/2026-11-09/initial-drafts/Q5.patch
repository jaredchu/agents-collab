+/// `[total, active, unverified, finished]` from one `list --summary` count
+/// object, which must hold exactly these integer keys.
+#[track_caller]
+fn counts(value: &Value) -> [u64; 4] {
+    let object = value.as_object().unwrap();
+    let mut keys: Vec<_> = object.keys().map(String::as_str).collect();
+    keys.sort_unstable();
+    assert_eq!(keys, ["active", "finished", "total", "unverified"]);
+    let field = |key: &str| object[key].as_u64().unwrap();
+    [
+        field("total"),
+        field("active"),
+        field("unverified"),
+        field("finished"),
+    ]
+}
+
+#[test]
+fn list_summary_counts_selected_and_retained_jobs_without_job_data() {
+    use serde_json::json;
+    let fixture = Fixture::new();
+    let (record, launch) = fixture.finished_template();
+    let launched = fixture
+        .command(&[
+            "run",
+            "--ttl",
+            "30s",
+            "--grace",
+            "100ms",
+            "--owner",
+            "summary-secret-owner",
+            "--task",
+            "summary-secret-task",
+            "--name",
+            "summary-secret-name",
+            "--url",
+            "http://127.0.0.1:9/summary-secret-url",
+            "--",
+            "/bin/sh",
+            "-c",
+            "sleep 30",
+            "summary-secret-argv",
+        ])
+        .env("PROCLEASE_SUMMARY_SECRET", "summary-secret-env")
+        .output()
+        .unwrap();
+    assert!(launched.status.success(), "{}", describe(&launched));
+    let live = parse(&launched)["job"]["id"].as_str().unwrap().to_owned();
+    wait(|| (fixture.job(&live)["state"] == "running").then_some(()));
+
+    let mut seeded = record.clone();
+    for (field, value) in [
+        ("argv", json!(["/bin/echo", "summary-secret-argv"])),
+        ("cwd", json!("/summary-secret-cwd")),
+        ("owner", json!("summary-secret-owner")),
+        ("task", json!("summary-secret-task")),
+        ("name", json!("summary-secret-name")),
+        ("url", json!("http://127.0.0.1:9/summary-secret-url")),
+        ("error", json!("summary-secret-error")),
+    ] {
+        seeded[field] = value;
+    }
+    let unknown = "0000000000a1"; // unverified; never collected
+    let recent = "0000000000a2"; // finished inside the default 30s window
+    let old = "0000000000a3"; // finished 1h ago: retained, hidden by default
+    let untimed = "0000000000a4"; // finished state without a finish time
+    let corrupt = "0000000000a5"; // unreadable: a scan warning, never counted
+    let now = now_ms();
+    let mut unknown_record = seeded.clone();
+    unknown_record["state"] = json!("unknown");
+    fixture.seed_history(unknown, &unknown_record, &launch, now - 3_600_000);
+    fixture.seed_history(recent, &seeded, &launch, now - 1_000);
+    fixture.seed_history(old, &seeded, &launch, now - 3_600_000);
+    // A finished state whose finish time was never recorded.
+    let mut bare = seeded.clone();
+    bare["id"] = json!(untimed);
+    bare["finished_at_ms"] = Value::Null;
+    let mut bare_launch = launch.clone();
+    bare_launch["id"] = json!(untimed);
+    fixture.seed_files(
+        untimed,
+        &[
+            ("record.json", serde_json::to_vec(&bare).unwrap()),
+            ("launch.json", serde_json::to_vec(&bare_launch).unwrap()),
+        ],
+    );
+    fixture.seed_files(corrupt, &[("record.json", b"not json".to_vec())]);
+    let seeded_ids = [unknown, recent, old, untimed];
+    let record_bytes = |id: &str| fs::read(fixture.state.join(id).join("record.json")).ok();
+    let before: Vec<_> = seeded_ids.iter().map(|id| record_bytes(id)).collect();
+    assert!(before.iter().all(Option::is_some));
+    let deadline = fixture.job(&live)["expires_at_ms"].clone();
+
+    let human = |args: &[&str]| {
+        Command::new(env!("CARGO_BIN_EXE_proclease"))
+            .arg("--state-dir")
+            .arg(&fixture.state)
+            .args(args)
+            .output()
+            .unwrap()
+    };
+    let warnings = |value: &Value| {
+        let mut warnings: Vec<String> = value["warnings"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|w| w.as_str().unwrap().to_owned())
+            .collect();
+        warnings.sort();
+        warnings
+    };
+    let leaked = |text: &str| {
+        let mut needles = vec!["summary-secret", "/bin/", "sleep", live.as_str()];
+        needles.extend_from_slice(&seeded_ids);
+        needles
+            .into_iter()
+            .filter(|needle| text.contains(needle))
+            .map(str::to_owned)
+            .collect::<Vec<_>>()
+    };
+    let human_lines = |selected: &str, retained: &str| format!("{selected}\n{retained}\n");
+    let default_selected = "selected: 4 (active 1, unverified 2, finished 1)";
+    let retained_line = "retained: 5 (active 1, unverified 2, finished 2)";
+
+    // Default window: active, both unverified records and the recent finish.
+    let output = fixture.command(&["list", "--summary"]).output().unwrap();
+    assert!(output.status.success(), "{}", describe(&output));
+    let value = parse(&output);
+    let mut keys: Vec<_> = value.as_object().unwrap().keys().cloned().collect();
+    keys.sort();
+    let expected = ["retained", "schema_version", "selected", "warnings"];
+    assert_eq!(keys, expected);
+    assert_eq!(value["schema_version"], 1);
+    assert_eq!(counts(&value["selected"]), [4, 1, 2, 1]);
+    assert_eq!(counts(&value["retained"]), [5, 1, 2, 2]);
+    let listed = fixture.call(&["list"]);
+    assert_eq!(listed["jobs"].as_array().unwrap().len(), 4);
+    assert!(warnings(&value).iter().any(|w| w.contains(corrupt)));
+    assert_eq!(warnings(&value), warnings(&listed));
+    assert_eq!(leaked(&describe(&output)), Vec::<String>::new());
+
+    let output = human(&["list", "--summary"]);
+    assert!(output.status.success(), "{}", describe(&output));
+    assert_eq!(
+        String::from_utf8(output.stdout.clone()).unwrap(),
+        human_lines(default_selected, retained_line)
+    );
+    let stderr = String::from_utf8(output.stderr.clone()).unwrap();
+    assert!(stderr.contains(corrupt), "{stderr}");
+    assert!(stderr.lines().all(|line| line.starts_with("Warning: ")));
+    assert_eq!(leaked(&describe(&output)), Vec::<String>::new());
+
+    // --all selects every retained job; retained is independent of --all.
+    let output = fixture
+        .command(&["list", "--all", "--summary"])
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "{}", describe(&output));
+    let value = parse(&output);
+    assert_eq!(counts(&value["selected"]), [5, 1, 2, 2]);
+    assert_eq!(counts(&value["retained"]), [5, 1, 2, 2]);
+    assert!(value.get("jobs").is_none());
+    assert_eq!(
+        fixture.call(&["list", "--all"])["jobs"]
+            .as_array()
+            .unwrap()
+            .len(),
+        5
+    );
+    let listed = fixture.call(&["list", "--all"]);
+    assert_eq!(warnings(&value), warnings(&listed));
+    let output = human(&["list", "--summary", "--all"]);
+    assert!(output.status.success(), "{}", describe(&output));
+    assert_eq!(
+        String::from_utf8(output.stdout).unwrap(),
+        human_lines(
+            "selected: 5 (active 1, unverified 2, finished 2)",
+            retained_line
+        )
+    );
+
+    // --resources conflicts in either order and in both output modes; watch
+    // gains no summary option.
+    for args in [
+        &["list", "--summary", "--resources"][..],
+        &["list", "--resources", "--summary"][..],
+        &["list", "--all", "--summary", "--resources"][..],
+        &["watch", "--once", "--summary"][..],
+    ] {
+        for output in [fixture.command(args).output().unwrap(), human(args)] {
+            assert!(!output.status.success(), "{args:?}: {}", describe(&output));
+            assert!(output.stdout.is_empty(), "{args:?}: {}", describe(&output));
+            let stderr = String::from_utf8_lossy(&output.stderr);
+            assert!(!stderr.contains("selected:") && !stderr.contains(&live));
+        }
+    }
+
+    // Summaries renew nothing and rewrite no record.
+    let after: Vec<_> = seeded_ids.iter().map(|id| record_bytes(id)).collect();
+    assert_eq!(before, after);
+    let job = fixture.job(&live);
+    assert_eq!(job["state"], "running");
+    assert_eq!(job["expires_at_ms"], deadline);
+
+    // Stdout stays two lines however many jobs are retained.
+    for i in 0..20 {
+        fixture.seed_history(
+            &format!("00000000b{i:03x}"),
+            &seeded,
+            &launch,
+            now - 3_600_000,
+        );
+    }
+    let output = human(&["list", "--all", "--summary"]);
+    assert!(output.status.success(), "{}", describe(&output));
+    assert_eq!(
+        String::from_utf8(output.stdout).unwrap(),
+        human_lines(
+            "selected: 25 (active 1, unverified 2, finished 22)",
+            "retained: 25 (active 1, unverified 2, finished 22)"
+        )
+    );
+
+    let help = human(&["list", "--help"]);
+    assert!(help.status.success());
+    let help = String::from_utf8(help.stdout)
+        .unwrap()
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ");
+    for text in [
+        "--summary",
+        "active (starting, running, stopping)",
+        "unverified (unknown, or finished without a recorded finish time)",
+        "finished (all others)",
+    ] {
+        assert!(help.contains(text), "help lacks {text:?}: {help}");
+    }
+
+    fixture.call(&["stop", &live]);
+    // Teardown must not try to manage the seeded records.
+    for entry in fs::read_dir(&fixture.state).unwrap() {
+        let name = entry.unwrap().file_name().to_string_lossy().into_owned();
+        if name.starts_with("00000000") && name != live {
+            fs::remove_dir_all(fixture.state.join(name)).unwrap();
+        }
+    }
+}
