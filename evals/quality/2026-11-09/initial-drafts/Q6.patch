+#[test]
+fn invalid_cwd_fails_before_any_job_is_created() {
+    let fixture = Fixture::new();
+    let layout = CwdLayout::new(&fixture);
+    let file = layout.root.join("plain-file");
+    fs::write(&file, b"not a directory").unwrap();
+    let dangling = layout.root.join("dangling");
+    std::os::unix::fs::symlink("missing-target", &dangling).unwrap();
+    let missing = layout.root.join("missing");
+    let file_link = layout.root.join("file-link");
+    std::os::unix::fs::symlink("plain-file", &file_link).unwrap();
+    let nested = file.join("child");
+    let cases: [(&str, bool); 7] = [
+        ("", false),
+        (missing.to_str().unwrap(), true),
+        ("missing", true),
+        (dangling.to_str().unwrap(), true),
+        (file.to_str().unwrap(), true),
+        (file_link.to_str().unwrap(), true),
+        (nested.to_str().unwrap(), true),
+    ];
+    for (requested, exact) in cases {
+        let output = run_from(
+            &fixture,
+            &layout.root,
+            &[
+                "run",
+                "--ttl",
+                "30s",
+                "--cwd",
+                requested,
+                "--",
+                "/usr/bin/true",
+            ],
+        );
+        assert!(!output.status.success(), "{requested:?}");
+        if exact {
+            // Missing and non-directory paths use the JSON error envelope.
+            assert_eq!(output.status.code(), Some(1), "{requested:?}");
+            let result = parse(&output);
+            assert!(result["error"].is_string(), "{requested:?}: {result}");
+            assert!(result.get("job").is_none(), "{requested:?}: {result}");
+        }
+        assert!(fixture.no_jobs(), "{requested:?} created a job");
+    }
+    // Human output reports the same failure on stderr without a job.
+    let mut command = Command::new(env!("CARGO_BIN_EXE_proclease"));
+    let output = command
+        .arg("--state-dir")
+        .arg(&fixture.state)
+        .args(["run", "--cwd"])
+        .arg(&missing)
+        .args(["--", "/usr/bin/true"])
+        .output()
+        .unwrap();
+    assert_eq!(output.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&output.stderr).contains("--cwd"));
+    assert!(fixture.no_jobs());
+}
