+/// Directories for `--cwd` tests inside the fixture: `work/real` (launch
+/// target), `link` (symlink to it), `work/other` (a different directory) and
+/// `caller` (where the CLI itself runs). Returns them with the canonical target.
+struct CwdLayout {
+    root: PathBuf,
+    real: PathBuf,
+    link: PathBuf,
+    other: PathBuf,
+    caller: PathBuf,
+    canonical: PathBuf,
+}
+
+impl CwdLayout {
+    fn new(fixture: &Fixture) -> Self {
+        let root = fixture.dir.path().to_owned();
+        let real = root.join("work/real");
+        let other = root.join("work/other");
+        let caller = root.join("caller");
+        let link = root.join("link");
+        for dir in [&real, &other, &caller] {
+            fs::create_dir_all(dir).unwrap();
+        }
+        std::os::unix::fs::symlink("work/real", &link).unwrap();
+        let canonical = fs::canonicalize(&real).unwrap();
+        Self {
+            root,
+            real,
+            link,
+            other,
+            caller,
+            canonical,
+        }
+    }
+}
+
+/// Run the CLI from `caller` with a fixed minimal environment, so only the
+/// launch directory varies between otherwise identical launches.
+fn run_from(fixture: &Fixture, caller: &std::path::Path, args: &[&str]) -> Output {
+    let mut command = fixture.command(args);
+    command
+        .env_clear()
+        .env("PATH", "/usr/bin:/bin")
+        .current_dir(caller);
+    command.output().unwrap()
+}
+
+fn output_log(fixture: &Fixture, id: &str) -> String {
+    fs::read_to_string(fixture.state.join(id).join("output.log")).unwrap()
+}
+
+#[test]
+fn cwd_flag_starts_the_command_in_the_canonical_directory() {
+    let fixture = Fixture::new();
+    let layout = CwdLayout::new(&fixture);
+    let real = layout.real.to_str().unwrap().to_owned();
+    let link = layout.link.to_str().unwrap().to_owned();
+    for (caller, requested) in [
+        (&layout.caller, real.as_str()),
+        (&layout.root, "work/real"),
+        (&layout.caller, "../work/real"),
+        (&layout.caller, link.as_str()),
+        (&layout.root, "link"),
+    ] {
+        let output = run_from(
+            &fixture,
+            caller,
+            &[
+                "run", "--grace", "100ms", "--cwd", requested, "--", "/bin/pwd", "-P",
+            ],
+        );
+        assert!(
+            output.status.success(),
+            "{requested}: {}",
+            describe(&output)
+        );
+        let result = parse(&output);
+        assert_eq!(result["reused"], false);
+        assert_eq!(
+            result["job"]["cwd"],
+            layout.canonical.to_str().unwrap(),
+            "{requested}"
+        );
+        let id = result["job"]["id"].as_str().unwrap();
+        let job = fixture.terminal(id);
+        assert_eq!(job["state"], "exited", "{requested}: {job}");
+        assert_eq!(job["exit_code"], 0, "{requested}: {job}");
+        assert_eq!(
+            output_log(&fixture, id).trim_end(),
+            layout.canonical.to_str().unwrap(),
+            "{requested}"
+        );
+        let launch: Value =
+            serde_json::from_slice(&fs::read(fixture.state.join(id).join("launch.json")).unwrap())
+                .unwrap();
+        assert_eq!(launch["cwd"], layout.canonical.to_str().unwrap());
+    }
+
+    // Without --cwd the inherited directory is canonicalized as before.
+    let output = run_from(
+        &fixture,
+        &layout.link,
+        &["run", "--grace", "100ms", "--", "/bin/pwd", "-P"],
+    );
+    assert!(output.status.success(), "{}", describe(&output));
+    let result = parse(&output);
+    assert_eq!(result["job"]["cwd"], layout.canonical.to_str().unwrap());
+    let id = result["job"]["id"].as_str().unwrap();
+    assert_eq!(fixture.terminal(id)["state"], "exited");
+    assert_eq!(
+        output_log(&fixture, id).trim_end(),
+        layout.canonical.to_str().unwrap()
+    );
+}
