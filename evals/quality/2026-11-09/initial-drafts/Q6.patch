+/// Canonical launch directory: the caller's current directory, or `--cwd`
+/// resolved against it. Both forms are canonicalized the same way (symlinks
+/// resolved), so equal directories always yield the same retry identity. The
+/// CLI's own working directory is never changed; only the command starts here.
+fn launch_dir(requested: Option<&Path>) -> Result<PathBuf> {
+    let Some(path) = requested else {
+        return Ok(std::env::current_dir()?.canonicalize()?);
+    };
+    if path.as_os_str().is_empty() {
+        bail!("--cwd must not be empty");
+    }
+    let joined = if path.is_absolute() {
+        path.to_path_buf()
+    } else {
+        std::env::current_dir()?.join(path)
+    };
+    let canonical = joined
+        .canonicalize()
+        .with_context(|| format!("cannot use --cwd {}", path.display()))?;
+    if !canonical.is_dir() {
+        bail!("cannot use --cwd {}: not a directory", path.display());
+    }
+    Ok(canonical)
+}
