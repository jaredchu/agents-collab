+#[test]
+fn retry_identity_uses_the_canonical_launch_directory() {
+    let fixture = Fixture::new();
+    let layout = CwdLayout::new(&fixture);
+    let real = layout.real.to_str().unwrap().to_owned();
+    let link = layout.link.to_str().unwrap().to_owned();
+    let other = layout.other.to_str().unwrap().to_owned();
+    let run = |caller: &std::path::Path, key: &str, cwd: Option<&str>| {
+        let mut args = vec!["run", "--grace", "100ms", "--key", key];
+        if let Some(cwd) = cwd {
+            args.extend(["--cwd", cwd]);
+        }
+        args.extend(["--", "/usr/bin/true"]);
+        run_from(&fixture, caller, &args)
+    };
+    let rejected = |output: Output| {
+        assert_eq!(output.status.code(), Some(1), "{}", describe(&output));
+        assert!(parse(&output)["error"]
+            .as_str()
+            .unwrap()
+            .contains("different launch context"));
+    };
+
+    // Launched through an absolute --cwd from an unrelated caller directory.
+    let first = run(&layout.caller, "by-flag", Some(&real));
+    assert!(first.status.success(), "{}", describe(&first));
+    let id = parse(&first)["job"]["id"].as_str().unwrap().to_owned();
+    assert_eq!(fixture.terminal(&id)["state"], "exited");
+    for (caller, cwd) in [
+        (&layout.root, Some("work/real")),
+        (&layout.caller, Some(link.as_str())),
+        (&layout.root, Some("link")),
+        (&layout.real, None),
+        (&layout.link, None),
+        (&layout.other, Some(real.as_str())),
+    ] {
+        let retry = run(caller, "by-flag", cwd);
+        assert!(retry.status.success(), "{cwd:?}: {}", describe(&retry));
+        let retry = parse(&retry);
+        assert_eq!(retry["reused"], true, "{cwd:?}: {retry}");
+        assert_eq!(retry["job"]["id"], id.as_str(), "{cwd:?}");
+    }
+    rejected(run(&layout.caller, "by-flag", Some(&other)));
+    rejected(run(&layout.caller, "by-flag", None));
+    rejected(run(&layout.other, "by-flag", None));
+
+    // Launched by inheriting the directory; an explicit --cwd naming the same
+    // directory reuses it, while a different one is rejected even though the
+    // caller still runs in the original directory.
+    let first = run(&layout.real, "inherited", None);
+    assert!(first.status.success(), "{}", describe(&first));
+    let inherited = parse(&first)["job"]["id"].as_str().unwrap().to_owned();
+    assert_ne!(inherited, id);
+    assert_eq!(fixture.terminal(&inherited)["state"], "exited");
+    for cwd in [real.as_str(), link.as_str(), "."] {
+        let retry = parse(&run(&layout.real, "inherited", Some(cwd)));
+        assert_eq!(retry["reused"], true, "{cwd}: {retry}");
+        assert_eq!(retry["job"]["id"], inherited.as_str(), "{cwd}");
+    }
+    rejected(run(&layout.real, "inherited", Some(&other)));
+    rejected(run(&layout.real, "inherited", Some("..")));
+
+    assert_eq!(
+        fixture.call(&["list", "--all"])["jobs"]
+            .as_array()
+            .unwrap()
+            .len(),
+        2
+    );
+}
