+/// The program to execute. A relative path containing a slash names a file
+/// relative to the launch directory, not the supervisor's own directory; the
+/// standard library leaves that case platform-specific, so it is joined
+/// explicitly. Bare names keep normal PATH lookup and absolute paths are used
+/// as given. The command still sees its original argv[0].
+fn program_path(program: &str, cwd: &Path) -> PathBuf {
+    let path = Path::new(program);
+    if program.contains('/') && path.is_relative() {
+        cwd.join(path)
+    } else {
+        path.to_path_buf()
+    }
+}
