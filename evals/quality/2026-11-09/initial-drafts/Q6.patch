+#[test]
+fn relative_command_paths_resolve_against_the_launch_directory() {
+    let fixture = Fixture::new();
+    let layout = CwdLayout::new(&fixture);
+    // The same relative command path names different programs in the caller
+    // and launch directories; only the launch directory's one succeeds.
+    for (dir, target) in [
+        (&layout.real, "/bin/pwd"),
+        (&layout.caller, "/usr/bin/false"),
+    ] {
+        fs::create_dir(dir.join("bin")).unwrap();
+        std::os::unix::fs::symlink(target, dir.join("bin/tool")).unwrap();
+    }
+    let real = layout.real.to_str().unwrap().to_owned();
+    for (caller, cwd, program) in [
+        (&layout.caller, Some(real.as_str()), "./bin/tool"),
+        (&layout.caller, Some(real.as_str()), "bin/tool"),
+        (&layout.caller, Some("../work/real"), "./bin/../bin/tool"),
+        // Without --cwd the inherited directory is the launch directory.
+        (&layout.real, None, "./bin/tool"),
+    ] {
+        let mut args = vec!["run", "--grace", "100ms"];
+        if let Some(cwd) = cwd {
+            args.extend(["--cwd", cwd]);
+        }
+        args.extend(["--", program, "-P"]);
+        let output = run_from(&fixture, caller, &args);
+        assert!(output.status.success(), "{program}: {}", describe(&output));
+        let result = parse(&output);
+        // The argument vector is recorded as given.
+        assert_eq!(result["job"]["argv"][0], program);
+        let id = result["job"]["id"].as_str().unwrap();
+        let job = fixture.terminal(id);
+        assert_eq!(job["state"], "exited", "{program}: {job}");
+        assert_eq!(job["exit_code"], 0, "{program}: {job}");
+        assert_eq!(
+            output_log(&fixture, id).trim_end(),
+            layout.canonical.to_str().unwrap(),
+            "{program}"
+        );
+    }
+
+    // A missing relative program in the launch directory is a failed launch,
+    // even though the caller's directory has one at that path.
+    let output = run_from(
+        &fixture,
+        &layout.real,
+        &[
+            "run",
+            "--grace",
+            "100ms",
+            "--cwd",
+            layout.other.to_str().unwrap(),
+            "--",
+            "./bin/tool",
+        ],
+    );
+    let result = parse(&output);
+    let id = result["job"]["id"].as_str().unwrap();
+    assert_eq!(fixture.terminal(id)["state"], "failed", "{result}");
+
+    // Names without a slash still use PATH lookup.
+    let output = run_from(
+        &fixture,
+        &layout.caller,
+        &["run", "--grace", "100ms", "--cwd", &real, "--", "pwd", "-P"],
+    );
+    assert!(output.status.success(), "{}", describe(&output));
+    let id = parse(&output)["job"]["id"].as_str().unwrap().to_owned();
+    assert_eq!(fixture.terminal(&id)["state"], "exited");
+    assert_eq!(
+        output_log(&fixture, &id).trim_end(),
+        layout.canonical.to_str().unwrap()
+    );
+}
