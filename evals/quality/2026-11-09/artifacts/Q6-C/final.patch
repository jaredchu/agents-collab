+
+#[test]
+fn relative_scripts_keep_their_invocation_name() {
+    use std::os::unix::fs::PermissionsExt;
+    let fixture = Fixture::new();
+    let layout = CwdLayout::new(&fixture);
+    // A `#!` interpreter receives the exec path as the script name, so `$0`
+    // shows whether the relative path was passed through unchanged. The
+    // caller's copy of the script must never run.
+    for (dir, label) in [(&layout.real, "launch"), (&layout.caller, "caller")] {
+        fs::create_dir(dir.join("bin")).unwrap();
+        let script = dir.join("bin/name");
+        fs::write(
+            &script,
+            format!("#!/bin/sh\nprintf '{label} %s\\n' \"$0\"\n"),
+        )
+        .unwrap();
+        fs::set_permissions(&script, fs::Permissions::from_mode(0o755)).unwrap();
+    }
+    let real = layout.real.to_str().unwrap().to_owned();
+    for (caller, cwd, program) in [
+        // Without --cwd the invocation is unchanged from earlier releases.
+        (&layout.real, None, "./bin/name"),
+        (&layout.real, None, "bin/name"),
+        (&layout.caller, Some(real.as_str()), "./bin/name"),
+        (&layout.caller, Some("../work/real"), "bin/name"),
+    ] {
+        let mut args = vec!["run", "--grace", "100ms"];
+        if let Some(cwd) = cwd {
+            args.extend(["--cwd", cwd]);
+        }
+        args.extend(["--", program]);
+        let output = run_from(&fixture, caller, &args);
+        assert!(output.status.success(), "{program}: {}", describe(&output));
+        let id = parse(&output)["job"]["id"].as_str().unwrap().to_owned();
+        let job = fixture.terminal(&id);
+        assert_eq!(job["state"], "exited", "{program} {cwd:?}: {job}");
+        assert_eq!(job["exit_code"], 0, "{program} {cwd:?}: {job}");
+        assert_eq!(
+            output_log(&fixture, &id).trim_end(),
+            format!("launch {program}"),
+            "{cwd:?}"
+        );
+    }
+}
