+impl Fixture {
+    /// Seed a record derived from a finished template with an exact persisted
+    /// state, a distinct creation time (so list order is fully determined) and
+    /// the given field overrides. No live process belongs to it.
+    fn seed_state(
+        &self,
+        id: &str,
+        template: &(Value, Value),
+        state: &str,
+        created: u64,
+        overrides: &[(&str, Value)],
+    ) {
+        let (record, launch) = template;
+        let mut record = record.clone();
+        record["id"] = serde_json::json!(id);
+        record["state"] = serde_json::json!(state);
+        record["created_at_ms"] = serde_json::json!(created);
+        for (field, value) in overrides {
+            record[*field] = value.clone();
+        }
+        let mut launch = launch.clone();
+        launch["id"] = serde_json::json!(id);
+        self.seed_files(
+            id,
+            &[
+                ("record.json", serde_json::to_vec(&record).unwrap()),
+                ("launch.json", serde_json::to_vec(&launch).unwrap()),
+                ("output.log", b"seeded".to_vec()),
+            ],
+        );
+    }
+}
+
+fn job_ids(value: &Value) -> Vec<String> {
+    value["jobs"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|job| job["id"].as_str().unwrap().to_owned())
+        .collect()
+}
