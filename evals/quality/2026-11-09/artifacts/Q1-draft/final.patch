+#[test]
+fn list_state_filter_accepts_exactly_the_json_state_names() {
+    let fixture = Fixture::new();
+    let template = fixture.finished_template();
+    let failed = "0000000000f1";
+    fixture.seed_state(
+        failed,
+        &template,
+        "failed",
+        1_000,
+        &[
+            ("reason", serde_json::json!("command_exit")),
+            ("exit_code", serde_json::json!(1)),
+            ("finished_at_ms", serde_json::json!(now_ms())),
+        ],
+    );
+    assert_eq!(
+        job_ids(&fixture.call(&["list", "--state", "failed"])),
+        [failed]
+    );
+    for name in LIST_STATES {
+        let value = fixture.call(&["list", "--all", "--state", name]);
+        let expected: &[&str] = if name == "failed" { &[failed] } else { &[] };
+        assert_eq!(job_ids(&value), expected, "--state {name}");
+    }
+
+    let record_path = fixture.state.join(failed).join("record.json");
+    let before = fs::read(&record_path).unwrap();
+    let invalid: [&[&str]; 12] = [
+        &["--state", "Failed"],
+        &["--state", "FAILED"],
+        &["--state", "failed,exited"],
+        &["--state", "failed,"],
+        &["--state", "active"],
+        &["--state", "unverified"],
+        &["--state", "finished"],
+        &["--state", "fail"],
+        &["--state", " failed"],
+        &["--state", ""],
+        &["--state", "failed", "--state", "Exited"],
+        &["--state"],
+    ];
+    for args in invalid {
+        let mut json_args = vec!["list", "--all"];
+        json_args.extend_from_slice(args);
+        for output in [
+            fixture.command(&json_args).output().unwrap(),
+            fixture
+                .human(&[&["--color", "never"][..], &json_args[..]].concat())
+                .output()
+                .unwrap(),
+        ] {
+            assert!(!output.status.success(), "{args:?}: {}", describe(&output));
+            assert!(output.stdout.is_empty(), "{args:?}: {}", describe(&output));
+            assert!(
+                !String::from_utf8_lossy(&output.stderr).contains(failed),
+                "{args:?}: {}",
+                describe(&output)
+            );
+        }
+    }
+    assert_eq!(fs::read(&record_path).unwrap(), before);
+
+    let help = fixture.human(&["list", "--help"]).output().unwrap();
+    assert!(help.status.success());
+    let help = String::from_utf8_lossy(&help.stdout)
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ");
+    assert!(help.contains("--state <STATE>"), "{help}");
+    assert!(
+        help.contains(&format!("[possible values: {}]", LIST_STATES.join(", "))),
+        "{help}"
+    );
+    fs::remove_dir_all(fixture.state.join(failed)).unwrap();
+}
