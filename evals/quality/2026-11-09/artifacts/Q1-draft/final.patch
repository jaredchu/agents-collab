+#[test]
+fn list_state_filter_matches_displayed_state_before_the_recent_window_and_only_reads() {
+    let fixture = Fixture::new();
+    let template = fixture.finished_template();
+    let guardian = template.0["guardian_pid"].clone();
+    assert!(guardian.is_u64(), "{guardian}");
+    let now = now_ms();
+    let mut created = 1_000;
+    let mut next_created = || {
+        created += 1;
+        created
+    };
+    let failed_fields = |finished: u64| {
+        vec![
+            ("reason", serde_json::json!("command_exit")),
+            ("exit_code", serde_json::json!(1)),
+            ("finished_at_ms", serde_json::json!(finished)),
+        ]
+    };
+    let unfinished = [
+        ("finished_at_ms", Value::Null),
+        ("exit_code", Value::Null),
+        ("command_pid", Value::Null),
+    ];
+
+    // Six exited jobs finished more recently than any failure, so the
+    // unfiltered recent window holds only exited jobs.
+    let exited: Vec<String> = (1..=6).map(|i| format!("0000000000e{i}")).collect();
+    for (i, id) in exited.iter().enumerate() {
+        let finished = serde_json::json!(now - 1 - i as u64);
+        fixture.seed_state(
+            id,
+            &template,
+            "exited",
+            next_created(),
+            &[("finished_at_ms", finished)],
+        );
+    }
+    // Seven recent failures (f1 newest) and two outside the 30s window.
+    let recent_failed: Vec<String> = (1..=7).map(|i| format!("0000000000f{i}")).collect();
+    for (i, id) in recent_failed.iter().enumerate() {
+        let finished = now - 100 - i as u64;
+        fixture.seed_state(
+            id,
+            &template,
+            "failed",
+            next_created(),
+            &failed_fields(finished),
+        );
+    }
+    let old_failed: Vec<String> = (1..=2).map(|i| format!("0000000000d{i}")).collect();
+    for (i, id) in old_failed.iter().enumerate() {
+        let finished = now - 60_000 - i as u64;
+        fixture.seed_state(
+            id,
+            &template,
+            "failed",
+            next_created(),
+            &failed_fields(finished),
+        );
+    }
+    // A running record without a supervisor endpoint is displayed as unknown.
+    let unverified = "0000000000a1";
+    let mut fields = unfinished.to_vec();
+    fields.extend([("reason", Value::Null), ("guardian_pid", Value::Null)]);
+    fixture.seed_state(unverified, &template, "running", next_created(), &fields);
+    // A stopping record with no recorded guardian group stays stopping.
+    let stopping = "0000000000a2";
+    let mut fields = unfinished.to_vec();
+    fields.extend([
+        ("reason", serde_json::json!("requested")),
+        ("guardian_pid", Value::Null),
+    ]);
+    fixture.seed_state(stopping, &template, "stopping", next_created(), &fields);
+    // A stopping record whose guardian group is gone is displayed as stopped,
+    // without a verified completion time, so it is never hidden by the window.
+    let observed_stopped = "0000000000a3";
+    let mut fields = unfinished.to_vec();
+    fields.extend([
+        ("reason", serde_json::json!("requested")),
+        ("guardian_pid", guardian),
+    ]);
+    fixture.seed_state(
+        observed_stopped,
+        &template,
+        "stopping",
+        next_created(),
+        &fields,
+    );
+    // History past the 24h retention bound, collected by any list call.
+    let expired_history = "0000000000c1";
+    let day_old = serde_json::json!(now - 25 * 60 * 60 * 1000);
+    fixture.seed_state(
+        expired_history,
+        &template,
+        "exited",
+        next_created(),
+        &[("finished_at_ms", day_old)],
+    );
+    let corrupt = "0000000000bb";
+    fixture.seed_files(corrupt, &[("record.json", b"not json".to_vec())]);
+
+    // Opportunistic collection still runs with a filter, regardless of match.
+    let first = fixture.call(&["list", "--state", "failed"]);
+    assert!(!fixture.state.join(expired_history).exists());
+    assert_eq!(job_ids(&first), &recent_failed[..5]);
+
+    let before = state_snapshot(&fixture.state);
+    let has_warning = |value: &Value| {
+        value["warnings"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|w| w.as_str().unwrap().contains(corrupt))
+    };
+
+    // Without a filter: active, then unverified or untimed, then the five
+    // newest finished jobs (each group by creation time), all exited.
+    // Failures are outside the shared window.
+    let unfiltered = fixture.call(&["list"]);
+    let mut expected = vec![
+        stopping.to_owned(),
+        unverified.to_owned(),
+        observed_stopped.to_owned(),
+    ];
+    expected.extend(exited[..5].iter().cloned());
+    assert_eq!(job_ids(&unfiltered), expected);
+    let state_of = |value: &Value, id: &str| {
+        let jobs = value["jobs"].as_array().unwrap();
+        let job = jobs.iter().find(|job| job["id"] == id).unwrap();
+        job["state"].clone()
+    };
+    assert_eq!(state_of(&unfiltered, unverified), "unknown");
+    assert_eq!(state_of(&unfiltered, stopping), "stopping");
+    assert_eq!(state_of(&unfiltered, observed_stopped), "stopped");
+    assert!(has_warning(&unfiltered));
+    // `watch` is unchanged and has no filter.
+    assert_eq!(fixture.call(&["watch", "--once"]), unfiltered);
+    let watch = fixture
+        .command(&["watch", "--once", "--state", "failed"])
+        .output()
+        .unwrap();
+    assert!(!watch.status.success() && watch.stdout.is_empty());
+
+    // Filtering precedes the recent window: the five newest failures appear.
+    let failed = fixture.call(&["list", "--state", "failed"]);
+    assert_eq!(job_ids(&failed), &recent_failed[..5]);
+    assert!(has_warning(&failed));
+    assert_eq!(
+        fixture.call(&["list", "--state", "failed", "--state", "failed"]),
+        failed
+    );
+    // OR across names; the window applies to the combined matches.
+    let either = fixture.call(&["list", "--state", "exited", "--state", "failed"]);
+    assert_eq!(job_ids(&either), &exited[..5]);
+
+    // Displayed, not persisted, state is matched.
+    let running = fixture.call(&["list", "--all", "--state", "running"]);
+    assert!(job_ids(&running).is_empty());
+    assert!(has_warning(&running));
+    assert_eq!(
+        job_ids(&fixture.call(&["list", "--state", "unknown"])),
+        [unverified]
+    );
+    assert_eq!(
+        job_ids(&fixture.call(&["list", "--state", "stopping"])),
+        [stopping]
+    );
+    assert_eq!(
+        job_ids(&fixture.call(&["list", "--state", "stopped"])),
+        [observed_stopped]
+    );
+    // Requested order does not affect output order.
+    let mixed = fixture.call(&["list", "--state", "stopped", "--state", "unknown"]);
+    assert_eq!(job_ids(&mixed), [unverified, observed_stopped]);
+    for name in ["starting", "expired", "interrupted"] {
+        let none = fixture.call(&["list", "--all", "--state", name]);
+        assert!(job_ids(&none).is_empty(), "{name}");
+    }
+
+    // With --all, every retained match, identical to the unfiltered entries.
+    let all = fixture.call(&["list", "--all"]);
+    for names in [
+        &["failed"][..],
+        &["failed", "exited"][..],
+        &["unknown", "stopping", "stopped"][..],
+    ] {
+        let mut args = vec!["list", "--all"];
+        for name in names {
+            args.extend(["--state", name]);
+        }
+        let filtered = fixture.call(&args);
+        let expected: Vec<Value> = all["jobs"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .filter(|job| names.iter().any(|name| job["state"] == *name))
+            .cloned()
+            .collect();
+        assert_eq!(filtered["jobs"], Value::Array(expected), "{names:?}");
+        assert_eq!(filtered["schema_version"], all["schema_version"]);
+        assert_eq!(filtered["warnings"], all["warnings"]);
+        assert_eq!(
+            filtered.as_object().unwrap().keys().collect::<Vec<_>>(),
+            all.as_object().unwrap().keys().collect::<Vec<_>>()
+        );
+    }
+    let all_failed = fixture.call(&["list", "--all", "--state", "failed"]);
+    assert_eq!(all_failed["jobs"].as_array().unwrap().len(), 9);
+
+    // Resources keep the same selection and field.
+    let measured = fixture.call(&["list", "--all", "--state", "failed", "--resources"]);
+    assert_eq!(job_ids(&measured), job_ids(&all_failed));
+    assert!(measured["jobs"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .all(|job| job.get("resources").is_some_and(Value::is_null)));
+    let measured = fixture.call(&["list", "--state", "failed", "--resources"]);
+    assert_eq!(job_ids(&measured), job_ids(&failed));
+
+    // Human output is restricted the same way and still reports warnings.
+    for args in [
+        &["list", "--state", "failed"][..],
+        &["list", "--state", "failed", "--resources"][..],
+    ] {
+        let output = fixture
+            .human(&[&["--color", "never"][..], args].concat())
+            .env("COLUMNS", "200")
+            .output()
+            .unwrap();
+        assert!(output.status.success(), "{}", describe(&output));
+        let stdout = String::from_utf8_lossy(&output.stdout);
+        for id in &recent_failed[..5] {
+            assert!(stdout.contains(id.as_str()), "{stdout}");
+        }
+        for id in recent_failed[5..]
+            .iter()
+            .chain(&old_failed)
+            .chain(&exited)
+            .map(String::as_str)
+            .chain([unverified, stopping, observed_stopped])
+        {
+            assert!(!stdout.contains(id), "{id} in {stdout}");
+        }
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        assert!(
+            stderr.contains("Warning:") && stderr.contains(corrupt),
+            "{stderr}"
+        );
+    }
+    let output = fixture
+        .human(&["list", "--all", "--state", "unknown"])
+        .output()
+        .unwrap();
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    assert!(stdout.contains(unverified), "{stdout}");
+    assert!(!stdout.contains(stopping), "{stdout}");
+
+    // Nothing above renewed, signalled or rewrote any job.
+    assert_eq!(state_snapshot(&fixture.state), before);
+    // Every job directory here is seeded; teardown must not manage them.
+    for entry in fs::read_dir(&fixture.state).unwrap().flatten() {
+        if entry.file_type().unwrap().is_dir() {
+            fs::remove_dir_all(entry.path()).unwrap();
+        }
+    }
+}
