@@ -3137,6 +3137,18 @@ fn invalid_cwd_fails_before_any_job_is_created() {
     assert_eq!(output.status.code(), Some(1));
     assert!(String::from_utf8_lossy(&output.stderr).contains("--cwd"));
     assert!(fixture.no_jobs());
+
+    // A flag without a value is an argument-parser error (Clap's exit 2, no
+    // JSON envelope), distinct from a nonexistent path; it never launches in
+    // the caller's directory or takes the command as the path.
+    let output = run_from(
+        &fixture,
+        &layout.root,
+        &["run", "--cwd", "--", "/usr/bin/true"],
+    );
+    assert_eq!(output.status.code(), Some(2), "{}", describe(&output));
+    assert!(output.stdout.is_empty(), "{}", describe(&output));
+    assert!(fixture.no_jobs());
 }
 
