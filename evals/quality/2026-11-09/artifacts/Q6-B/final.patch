+
+#[test]
+fn interpreter_scripts_keep_their_relative_pathname() {
+    use std::os::unix::fs::PermissionsExt;
+    let fixture = Fixture::new();
+    let layout = CwdLayout::new(&fixture);
+    // Shebang handling passes the exec pathname to the interpreter as `$0`;
+    // it must stay as given, with or without --cwd. The caller's directory has
+    // a script at the same path that fails, so resolution is also checked.
+    for (dir, body) in [
+        (&layout.real, "printf '%s\\n' \"$0\"\npwd -P\n"),
+        (&layout.caller, "exit 7\n"),
+    ] {
+        fs::create_dir(dir.join("bin")).unwrap();
+        let script = dir.join("bin/script");
+        fs::write(&script, format!("#!/bin/sh\n{body}")).unwrap();
+        fs::set_permissions(&script, fs::Permissions::from_mode(0o755)).unwrap();
+    }
+    let real = layout.real.to_str().unwrap().to_owned();
+    for (caller, cwd, program) in [
+        (&layout.caller, Some(real.as_str()), "./bin/script"),
+        (&layout.caller, Some("../work/real"), "bin/script"),
+        (&layout.real, None, "./bin/script"),
+        (&layout.real, None, "bin/script"),
+    ] {
+        let mut args = vec!["run", "--grace", "100ms"];
+        if let Some(cwd) = cwd {
+            args.extend(["--cwd", cwd]);
+        }
+        args.extend(["--", program]);
+        let output = run_from(&fixture, caller, &args);
+        assert!(output.status.success(), "{program}: {}", describe(&output));
+        let result = parse(&output);
+        assert_eq!(result["job"]["argv"][0], program);
+        let id = result["job"]["id"].as_str().unwrap();
+        let job = fixture.terminal(id);
+        assert_eq!(job["state"], "exited", "{program} {cwd:?}: {job}");
+        assert_eq!(job["exit_code"], 0, "{program} {cwd:?}: {job}");
+        assert_eq!(
+            output_log(&fixture, id),
+            format!("{program}\n{}\n", layout.canonical.to_str().unwrap()),
+            "{program} {cwd:?}"
+        );
+    }
+}
