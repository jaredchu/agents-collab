+    /// Seed a finished (`exited`) job record with a prepared `output.log`.
+    /// Nothing is launched: `logs` reads only these two files.
+    fn seed_finished_log(&self, id: &str, logs_truncated: bool, log: &[u8]) {
+        use std::os::unix::fs::DirBuilderExt;
+        fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(&self.state)
+            .unwrap();
+        let finished = now_ms();
+        let record = serde_json::json!({
+            "schema_version": 1,
+            "id": id,
+            "argv": ["/usr/bin/true"],
+            "cwd": self.dir.path(),
+            "owner": "test",
+            "task": null,
+            "name": null,
+            "url": null,
+            "created_at_ms": finished - 1_000,
+            "expires_at_ms": finished + 3_600_000,
+            "state": "exited",
+            "reason": "command_exit",
+            "keeper_pid": 0,
+            "guardian_pid": null,
+            "command_pid": null,
+            "exit_code": 0,
+            "finished_at_ms": finished,
+            "log_limit_bytes": 1_048_576,
+            "logs_truncated": logs_truncated,
+            "error": null,
+        });
+        self.seed_files(
+            id,
+            &[
+                ("record.json", serde_json::to_vec(&record).unwrap()),
+                ("output.log", log.to_vec()),
+            ],
+        );
+    }
 }
 
