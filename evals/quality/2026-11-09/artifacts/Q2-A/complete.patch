+impl Fixture {
+    /// `logs` without `--json`, for checking human stdout/stderr exactly.
+    fn human_logs(&self, args: &[&str]) -> Output {
+        Command::new(env!("CARGO_BIN_EXE_proclease"))
+            .arg("--state-dir")
+            .arg(&self.state)
+            .arg("logs")
+            .args(args)
+            .output()
+            .unwrap()
+    }
+    fn json_logs(&self, args: &[&str]) -> Output {
+        let mut full = vec!["logs"];
+        full.extend_from_slice(args);
+        self.command(&full).output().unwrap()
+    }
+    /// Seed a finished (`exited`) job record with a prepared `output.log`.
+    /// Nothing is launched: `logs` reads only these two files.
+    fn seed_finished_log(&self, id: &str, logs_truncated: bool, log: &[u8]) {
+        use std::os::unix::fs::DirBuilderExt;
+        fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(&self.state)
+            .unwrap();
+        let finished = now_ms();
+        let record = serde_json::json!({
+            "schema_version": 1,
+            "id": id,
+            "argv": ["/usr/bin/true"],
+            "cwd": self.dir.path(),
+            "owner": "test",
+            "task": null,
+            "name": null,
+            "url": null,
+            "created_at_ms": finished - 1_000,
+            "expires_at_ms": finished + 3_600_000,
+            "state": "exited",
+            "reason": "command_exit",
+            "keeper_pid": 0,
+            "guardian_pid": null,
+            "command_pid": null,
+            "exit_code": 0,
+            "finished_at_ms": finished,
+            "log_limit_bytes": 1_048_576,
+            "logs_truncated": logs_truncated,
+            "error": null,
+        });
+        self.seed_files(
+            id,
+            &[
+                ("record.json", serde_json::to_vec(&record).unwrap()),
+                ("output.log", log.to_vec()),
+            ],
+        );
+    }
+}
+
+/// A failed `logs` call printed no log line: human stdout is empty and JSON
+/// stdout is empty (parser error) or an error envelope without `lines`.
+#[track_caller]
+fn assert_no_log_lines(human: &Output, json: &Output, context: &str) {
+    assert!(!human.status.success(), "{context}: {}", describe(human));
+    assert!(human.stdout.is_empty(), "{context}: {}", describe(human));
+    assert!(!json.status.success(), "{context}: {}", describe(json));
+    if !json.stdout.is_empty() {
+        let value = parse(json);
+        assert!(value["error"].is_string(), "{context}: {value}");
+        assert!(value.get("lines").is_none(), "{context}: {value}");
+    }
+    for output in [human, json] {
+        let text = String::from_utf8_lossy(&output.stdout).into_owned()
+            + &String::from_utf8_lossy(&output.stderr);
+        assert!(!text.contains("log line"), "{context}: {text}");
+    }
+}
