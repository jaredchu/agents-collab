+const DEFAULT_LOG_LINES: usize = 50;
+const MAX_LOG_LINES: usize = 500;
+
+/// Which end of the captured output `logs` prints.
+#[derive(Clone, Copy, Debug)]
+enum LineSelection {
+    Head(usize),
+    Tail(usize),
+}
+
+/// The selected lines of already-escaped log text, in log order.
+fn select_lines(text: &str, selection: LineSelection) -> Vec<&str> {
+    match selection {
+        LineSelection::Head(count) => text.lines().take(count).collect(),
+        LineSelection::Tail(count) => {
+            let mut lines: Vec<_> = text.lines().rev().take(count).collect();
+            lines.reverse();
+            lines
+        }
+    }
+}
