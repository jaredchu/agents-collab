+#[test]
+fn logs_head_selects_bounds_conflicts_escapes_and_refuses_symlinks() {
+    let fixture = Fixture::new();
+
+    // 60 lines; line 2 carries terminal controls and line 3 ends in CRLF.
+    let mut log = String::new();
+    for n in 1..=60 {
+        match n {
+            2 => log.push_str("log line 2 \u{1b}[31mred\u{7}\n"),
+            3 => log.push_str("log line 3\r\n"),
+            _ => log.push_str(&format!("log line {n}\n")),
+        }
+    }
+    let id = "000000000001";
+    fixture.seed_finished_log(id, false, log.as_bytes());
+    let expected: Vec<String> = (1..=60)
+        .map(|n| match n {
+            2 => "log line 2 \\u{1b}[31mred\\u{7}".to_owned(),
+            // Escaping precedes line splitting, exactly as for --tail.
+            3 => "log line 3\\r".to_owned(),
+            _ => format!("log line {n}"),
+        })
+        .collect();
+
+    // Selection, in log order, with the same escaping as --tail.
+    let lines = |args: &[&str]| fixture.call(&[&["logs", id][..], args].concat())["lines"].clone();
+    assert_eq!(lines(&["--head", "3"]), serde_json::json!(expected[..3]));
+    assert_eq!(lines(&["--head", "1"]), serde_json::json!(expected[..1]));
+    assert_eq!(lines(&["--head", "500"]), serde_json::json!(expected));
+    assert_eq!(lines(&["--head", "60"]), serde_json::json!(expected));
+    assert_eq!(lines(&["--tail", "3"]), serde_json::json!(expected[57..]));
+    assert_eq!(lines(&["--tail", "500"]), serde_json::json!(expected));
+    // Without --head the default is still the last 50 lines.
+    assert_eq!(lines(&[]), serde_json::json!(expected[10..]));
+    let head = fixture.call(&["logs", id, "--head", "2"]);
+    assert!(!head.to_string().contains('\u{1b}'));
+    let mut keys: Vec<_> = head.as_object().unwrap().keys().cloned().collect();
+    keys.sort();
+    assert_eq!(keys, ["id", "lines", "logs_truncated", "schema_version"]);
+    assert_eq!(head["schema_version"], 1);
+    assert_eq!(head["id"], id);
+    assert_eq!(head["logs_truncated"], false);
+
+    let human = fixture.human_logs(&[id, "--head", "3"]);
+    assert!(human.status.success(), "{}", describe(&human));
+    assert_eq!(
+        String::from_utf8(human.stdout).unwrap(),
+        format!("{}\n", expected[..3].join("\n"))
+    );
+    assert!(human.stderr.is_empty());
+
+    // Bounds for both flags, and --head conflicts with any explicit --tail.
+    let rejected: &[&[&str]] = &[
+        &["--head", "0"],
+        &["--head", "501"],
+        &["--head", "-1"],
+        &["--head", "x"],
+        &["--head", ""],
+        &["--tail", "0"],
+        &["--tail", "501"],
+        &["--head", "3", "--tail", "50"],
+        &["--tail", "50", "--head", "3"],
+        &["--head", "3", "--tail", "5"],
+        &["--head", "0", "--tail", "50"],
+        &["--head", "500", "--tail", "500"],
+    ];
+    for args in rejected {
+        let args = [&[id][..], args].concat();
+        assert_no_log_lines(
+            &fixture.human_logs(&args),
+            &fixture.json_logs(&args),
+            &format!("{args:?}"),
+        );
+    }
+
+    // A log with fewer lines than requested is printed whole.
+    let short = "000000000002";
+    fixture.seed_finished_log(short, false, b"log line a\nlog line b");
+    assert_eq!(
+        fixture.call(&["logs", short, "--head", "5"])["lines"],
+        serde_json::json!(["log line a", "log line b"])
+    );
+
+    // The truncation note and flag are kept with --head.
+    let truncated = "000000000003";
+    fixture.seed_finished_log(truncated, true, log.as_bytes());
+    let head = fixture.call(&["logs", truncated, "--head", "2"]);
+    assert_eq!(head["logs_truncated"], true);
+    assert_eq!(head["lines"], serde_json::json!(expected[..2]));
+    let human = fixture.human_logs(&[truncated, "--head", "2"]);
+    assert!(human.status.success(), "{}", describe(&human));
+    assert_eq!(
+        String::from_utf8(human.stdout).unwrap(),
+        format!("{}\n", expected[..2].join("\n"))
+    );
+    assert!(String::from_utf8_lossy(&human.stderr).contains("Log capture reached its byte cap"));
+
+    // The same 16 MiB read bound applies to --head.
+    let oversized = "000000000004";
+    let mut big = b"log line first\n".to_vec();
+    big.resize(16 * 1_048_576 + 1, b'x');
+    fixture.seed_finished_log(oversized, false, &big);
+    for args in [&[oversized, "--head", "1"][..], &[oversized][..]] {
+        assert_no_log_lines(
+            &fixture.human_logs(args),
+            &fixture.json_logs(args),
+            &format!("{args:?}"),
+        );
+    }
+
+    // A symlinked output.log is refused with exit status 1 and no contents.
+    let linked = "000000000005";
+    fixture.seed_finished_log(linked, false, b"retained test output");
+    let secret = fixture.dir.path().join("secret.txt");
+    fs::write(&secret, "log line secret\n").unwrap();
+    let output = fixture.state.join(linked).join("output.log");
+    fs::remove_file(&output).unwrap();
+    std::os::unix::fs::symlink(&secret, &output).unwrap();
+    for args in [&[linked, "--head", "5"][..], &[linked][..]] {
+        let human = fixture.human_logs(args);
+        let json = fixture.json_logs(args);
+        assert_eq!(human.status.code(), Some(1), "{}", describe(&human));
+        assert_eq!(json.status.code(), Some(1), "{}", describe(&json));
+        assert_no_log_lines(&human, &json, &format!("{args:?}"));
+        for out in [&human, &json] {
+            assert!(!String::from_utf8_lossy(&out.stdout).contains("secret"));
+            assert!(!String::from_utf8_lossy(&out.stderr).contains("secret"));
+        }
+    }
+}
