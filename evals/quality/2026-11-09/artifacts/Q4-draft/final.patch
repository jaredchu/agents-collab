+#[test]
+fn prune_keep_is_deferred_while_retention_is_protected() {
+    use std::os::unix::fs::OpenOptionsExt;
+    let fixture = Fixture::new();
+    let now = now_ms();
+    let history = ["a00000000001", "a00000000002", "b00000000001"];
+    fixture.seed_collectable(history[0], now - 1_000);
+    fixture.seed_collectable(history[1], now - 2_000);
+    fixture.seed_collectable(history[2], now - DAY_MS);
+    // Hold the same shared protection a bulk stop takes.
+    let guard = fs::OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .read(true)
+        .write(true)
+        .mode(0o600)
+        .open(fixture.state.join(".retention"))
+        .unwrap();
+    fs2::FileExt::try_lock_shared(&guard).unwrap();
+    let preview = fixture.call(&["prune", "--dry-run", "--keep", "0"]);
+    assert_eq!(preview["deferred"], true, "{preview}");
+    assert_eq!(preview["removed"], serde_json::json!([]));
+    let report = fixture.call(&["prune", "--keep", "0"]);
+    assert_eq!(report["deferred"], true, "{report}");
+    assert_eq!(report["max_finished"], 0);
+    assert_eq!(report["candidates"], serde_json::json!([]));
+    assert_eq!(report["removed"], serde_json::json!([]));
+    assert!(history.iter().all(|id| fixture.present(id)));
+
+    drop(guard);
+    let report = fixture.call(&["prune", "--keep", "0"]);
+    assert_eq!(report["deferred"], false, "{report}");
+    assert_eq!(
+        ids(&report["removed"]),
+        ["b00000000001", "a00000000002", "a00000000001"]
+    );
+}
