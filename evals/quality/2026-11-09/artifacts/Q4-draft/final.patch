+// One-off retention count (`prune --keep N`). Seeded records are launches that
+// never had a supervisor, so collection needs no process verification.
+
+const DAY_MS: u64 = 24 * 60 * 60 * 1000;
+
+/// A failed launch whose keeper was never spawned (no keeper, guardian or
+/// command PID), finished at `finished`.
+fn unsupervised_failure(id: &str, finished: Option<u64>) -> (Value, Value) {
+    let created = finished.unwrap_or_else(now_ms).saturating_sub(1_000);
+    let record = serde_json::json!({
+        "schema_version": 1, "id": id, "argv": ["/proclease-does-not-exist"],
+        "cwd": "/", "owner": "test", "task": null, "name": null, "url": null,
+        "created_at_ms": created, "expires_at_ms": created + 60_000,
+        "state": "failed", "reason": "launch_failed", "keeper_pid": 0,
+        "guardian_pid": null, "command_pid": null, "exit_code": null,
+        "finished_at_ms": finished, "log_limit_bytes": 1_048_576,
+        "logs_truncated": false, "error": "cannot start supervisor: seeded",
+    });
+    let launch = serde_json::json!({
+        "id": id, "argv": ["/proclease-does-not-exist"], "cwd": "/",
+        "owner": "test", "task": null, "name": null, "url": null, "key": null,
+        "fingerprint": "v2:seeded", "created_at_ms": created,
+        "expires_at_ms": created + 60_000, "grace_ms": 100,
+        "log_limit_bytes": 1_048_576,
+    });
+    (record, launch)
+}
+
+impl Fixture {
+    fn seed_record(&self, record: &Value, launch: &Value) {
+        use std::os::unix::fs::DirBuilderExt;
+        if !self.state.exists() {
+            fs::DirBuilder::new()
+                .recursive(true)
+                .mode(0o700)
+                .create(&self.state)
+                .unwrap();
+        }
+        self.seed_files(
+            record["id"].as_str().unwrap(),
+            &[
+                ("record.json", serde_json::to_vec(record).unwrap()),
+                ("launch.json", serde_json::to_vec(launch).unwrap()),
+                ("output.log", b"retained test output".to_vec()),
+            ],
+        );
+    }
+    fn seed_collectable(&self, id: &str, finished: u64) {
+        let (record, launch) = unsupervised_failure(id, Some(finished));
+        self.seed_record(&record, &launch);
+    }
+    fn present(&self, id: &str) -> bool {
+        self.state.join(id).exists()
+    }
+}
+
+fn ids(value: &Value) -> Vec<String> {
+    value
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|id| id.as_str().unwrap().to_owned())
+        .collect()
+}
