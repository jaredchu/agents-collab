+#[test]
+fn prune_keep_rejects_invalid_values_before_deleting_anything() {
+    let fixture = Fixture::new();
+    let now = now_ms();
+    let history = ["a00000000001", "a00000000002", "b00000000001"];
+    fixture.seed_collectable(history[0], now - 1_000);
+    fixture.seed_collectable(history[1], now - 2_000);
+    fixture.seed_collectable(history[2], now - DAY_MS);
+    let invalid: [&[&str]; 10] = [
+        &["--keep", "101"],
+        &["--keep", "256"],
+        &["--keep", "1000"],
+        &["--keep=-1"],
+        &["--keep", "-1"],
+        &["--keep", "abc"],
+        &["--keep", "1.5"],
+        &["--keep", ""],
+        &["--keep"],
+        &["--dry-run", "--keep", "101"],
+    ];
+    for args in invalid {
+        let mut full = vec!["prune"];
+        full.extend_from_slice(args);
+        for mut command in [fixture.command(&full), fixture.human(&full)] {
+            let output = command.output().unwrap();
+            assert!(!output.status.success(), "{full:?} was accepted");
+            assert!(history.iter().all(|id| fixture.present(id)), "{full:?}");
+        }
+    }
+}
