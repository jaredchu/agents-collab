+#[test]
+fn prune_keep_100_matches_default_retention_beyond_the_count() {
+    let fixture = Fixture::new();
+    let now = now_ms();
+    fixture.seed_collectable("b00000000001", now - DAY_MS);
+    let recent: Vec<String> = (1..=102).map(|i| format!("{i:012x}")).collect();
+    for (index, id) in recent.iter().enumerate() {
+        fixture.seed_collectable(id, now - 1_000 - index as u64);
+    }
+    let mut expected = vec!["b00000000001".to_owned()];
+    expected.extend([recent[101].clone(), recent[100].clone()]);
+    let default = fixture.call(&["prune", "--dry-run"]);
+    let keep = fixture.call(&["prune", "--dry-run", "--keep", "100"]);
+    assert_eq!(ids(&default["candidates"]), expected);
+    assert_eq!(keep["candidates"], default["candidates"]);
+    assert_eq!(keep["max_finished"], 100);
+    assert_eq!(default["max_finished"], 100);
+    let report = fixture.call(&["prune", "--keep", "100"]);
+    assert_eq!(ids(&report["removed"]), expected);
+    for id in &recent[..100] {
+        assert!(fixture.present(id), "{id}");
+    }
+    assert!(!fixture.present(&recent[100]) && !fixture.present(&recent[101]));
+}
