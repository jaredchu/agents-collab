+#[test]
+fn prune_keep_never_collects_or_counts_protected_jobs() {
+    let fixture = Fixture::new();
+    let now = now_ms();
+    fixture.seed_collectable("c00000000001", now - 1_000);
+    fixture.seed_collectable("c00000000002", now - 2_000);
+
+    let (base, launch) = unsupervised_failure("000000000000", Some(1));
+    let mut classes: Vec<(&str, Value)> = Vec::new();
+    for state in ["starting", "running", "stopping", "unknown"] {
+        let mut record = base.clone();
+        record["state"] = state.into();
+        record["reason"] = Value::Null;
+        classes.push((state, record));
+    }
+    // Finished, but a supervisor process or group is observably alive.
+    let mut live_keeper = base.clone();
+    live_keeper["reason"] = "command_exit".into();
+    live_keeper["exit_code"] = 1.into();
+    live_keeper["keeper_pid"] = std::process::id().into();
+    classes.push(("live keeper", live_keeper));
+    let mut live_group = base.clone();
+    live_group["guardian_pid"] = unsafe { libc::getpgrp() }.into();
+    classes.push(("live guardian group", live_group));
+    // Each protected class is seeded once aged past 24h and once as the
+    // newest history, so it can neither be collected nor fill the count.
+    let mut protected = Vec::new();
+    for (index, (class, seeded)) in classes.iter().enumerate() {
+        for (prefix, finished) in [("e", 1), ("f", now)] {
+            let id = format!("{prefix}{index:011x}");
+            let mut record = seeded.clone();
+            record["id"] = id.clone().into();
+            record["finished_at_ms"] = finished.into();
+            let mut launch = launch.clone();
+            launch["id"] = id.clone().into();
+            fixture.seed_record(&record, &launch);
+            protected.push((id, *class));
+        }
+    }
+    let (missing, launch) = unsupervised_failure("d00000000001", None);
+    fixture.seed_record(&missing, &launch);
+    protected.push(("d00000000001".into(), "no finish time"));
+
+    let preview = fixture.call(&["prune", "--dry-run", "--keep", "1"]);
+    assert_eq!(ids(&preview["candidates"]), ["c00000000002"], "{preview}");
+    let preview = fixture.call(&["prune", "--dry-run", "--keep", "0"]);
+    assert_eq!(
+        ids(&preview["candidates"]),
+        ["c00000000002", "c00000000001"],
+        "{preview}"
+    );
+    let report = fixture.call(&["prune", "--keep", "0"]);
+    assert_eq!(report["removed"], preview["candidates"]);
+    assert_eq!(report["warnings"], serde_json::json!([]));
+    for (id, class) in &protected {
+        assert!(fixture.present(id), "{class} job {id} was collected");
+    }
+    let report = fixture.call(&["prune", "--keep", "0"]);
+    assert_eq!(report["candidates"], serde_json::json!([]));
+}
