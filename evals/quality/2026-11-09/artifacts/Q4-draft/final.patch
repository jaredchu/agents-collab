+#[test]
+fn prune_keep_replaces_the_count_limit_for_one_invocation_only() {
+    let fixture = Fixture::new();
+    let now = now_ms();
+    // Exactly 24h old when seeded, so at least 24h old when collected.
+    fixture.seed_collectable("b00000000001", now - DAY_MS);
+    // a3 and a4 tie on finish time; the lower ID is older, as for default
+    // retention.
+    for (id, age) in [
+        ("a00000000001", 1_000),
+        ("a00000000002", 2_000),
+        ("a00000000003", 3_000),
+        ("a00000000004", 3_000),
+        ("a00000000005", 5_000),
+    ] {
+        fixture.seed_collectable(id, now - age);
+    }
+    let oldest_first = [
+        "b00000000001",
+        "a00000000005",
+        "a00000000003",
+        "a00000000004",
+        "a00000000002",
+        "a00000000001",
+    ];
+
+    // At or above the collectable count only the 24h rule applies.
+    for keep in ["100", "6", "5"] {
+        let preview = fixture.call(&["prune", "--dry-run", "--keep", keep]);
+        assert_eq!(ids(&preview["candidates"]), ["b00000000001"], "{keep}");
+        assert_eq!(preview["max_finished"], keep.parse::<u64>().unwrap());
+        assert_eq!(preview["max_age_hours"], 24);
+        assert_eq!(preview["dry_run"], true);
+        assert_eq!(preview["deferred"], false);
+        assert_eq!(preview["removed"], serde_json::json!([]));
+    }
+    let preview = fixture.call(&["prune", "--dry-run", "--keep", "3"]);
+    assert_eq!(ids(&preview["candidates"]), &oldest_first[..3]);
+    let preview = fixture.call(&["prune", "--dry-run", "--keep", "0"]);
+    assert_eq!(ids(&preview["candidates"]), oldest_first);
+    assert!(oldest_first.iter().all(|id| fixture.present(id)));
+
+    // Human output keeps its form.
+    let output = fixture
+        .human(&["prune", "--dry-run", "--keep", "3"])
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    assert_eq!(
+        String::from_utf8_lossy(&output.stdout),
+        "Would remove 3 finished jobs.\nb00000000001\na00000000005\na00000000003\n"
+    );
+    assert!(oldest_first.iter().all(|id| fixture.present(id)));
+
+    // The dry run reports exactly what the real run removes.
+    let preview = fixture.call(&["prune", "--dry-run", "--keep", "3"]);
+    let report = fixture.call(&["prune", "--keep", "3"]);
+    assert_eq!(report["dry_run"], false);
+    assert_eq!(report["max_finished"], 3);
+    assert_eq!(report["candidates"], preview["candidates"]);
+    assert_eq!(report["removed"], preview["candidates"]);
+    for (index, id) in oldest_first.iter().enumerate() {
+        assert_eq!(fixture.present(id), index >= 3, "{id}");
+    }
+
+    // Nothing persists: every later collection uses the normal limits.
+    let report = fixture.call(&["prune"]);
+    assert_eq!(report["max_finished"], 100);
+    assert_eq!(report["removed"], serde_json::json!([]));
+    fixture.call(&["list"]);
+    fixture.call(&["list", "--all"]);
+    fixture.call(&["watch", "--once", "--all"]);
+    let run = fixture.call(&["run", "--grace", "100ms", "--", "/usr/bin/true"]);
+    let id = run["job"]["id"].as_str().unwrap().to_owned();
+    let done = fixture.terminal(&id);
+    // The keeper collects history after recording completion; wait for it.
+    let keeper = done["keeper_pid"].as_u64().unwrap() as i32;
+    wait(|| {
+        (unsafe { libc::kill(keeper, 0) } == -1
+            && std::io::Error::last_os_error().raw_os_error() == Some(libc::ESRCH))
+        .then_some(())
+    });
+    for id in &oldest_first[3..] {
+        assert!(fixture.present(id), "{id} collected after --keep ended");
+    }
+    assert!(fixture.present(&id));
+}
