+/// Explicit `list --sort` order. It only reorders the jobs already selected
+/// for display; it never changes which jobs are shown.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, clap::ValueEnum)]
+enum ListSort {
+    /// Finished jobs by creation time, oldest first.
+    Created,
+    /// Finished jobs by finish time, most recently finished first.
+    Finished,
+}
+
+/// Display group: 0 active, 1 unverified (unknown, or finished without a
+/// recorded finish time), 2 finished with a recorded finish time.
+fn list_group(record: &Record) -> u8 {
+    if record.state.active() {
+        0
+    } else if record.state == State::Unknown || record.finished_at_ms.is_none() {
+        1
+    } else {
+        2
+    }
+}
+
+/// Reorder selected jobs for `list --sort`. Active and unverified jobs keep
+/// their creation order; only confirmed finished jobs use finish time. Ties
+/// on the sort time are broken by job ID, so the order is total.
+fn order_jobs(jobs: &mut [Record], sort: ListSort) {
+    jobs.sort_by(|a, b| {
+        let group = list_group(a);
+        group
+            .cmp(&list_group(b))
+            .then_with(|| match (group, sort) {
+                (2, ListSort::Finished) => b.finished_at_ms.cmp(&a.finished_at_ms),
+                _ => a.created_at_ms.cmp(&b.created_at_ms),
+            })
+            .then_with(|| a.id.cmp(&b.id))
     });
+}
+
+fn select_visible(jobs: &mut Vec<Record>, all: bool, now: u64) {
+    jobs.sort_by_key(|r| (list_group(r), r.created_at_ms));
     if all {
         return;
     }
