+    fn job(id: &str, state: State, created: u64, finished: Option<u64>) -> Record {
+        let argv = strings(&["/usr/bin/true"]);
+        let mut record = Record::new(&launch(&argv, Path::new("/"), String::new()));
+        record.id = id.into();
+        record.state = state;
+        record.created_at_ms = created;
+        record.finished_at_ms = finished;
+        record
+    }
+
+    fn ids(jobs: &[Record]) -> Vec<&str> {
+        jobs.iter().map(|r| r.id.as_str()).collect()
+    }
+
+    fn id_set(jobs: &[Record]) -> std::collections::BTreeSet<&str> {
+        jobs.iter().map(|r| r.id.as_str()).collect()
+    }
+
+    /// Mixed groups, deliberately stored in an order that matches no rule.
+    fn mixed() -> Vec<Record> {
+        vec![
+            job("00000000000f", State::Exited, 50, Some(900)),
+            job("00000000000c", State::Stopped, 10, Some(100)),
+            job("000000000003", State::Unknown, 40, Some(9_999)),
+            job("00000000000a", State::Running, 30, None),
