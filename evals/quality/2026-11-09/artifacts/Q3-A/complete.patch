+    #[test]
+    fn list_sort_orders_finished_jobs_and_keeps_active_and_unverified_by_creation() {
+        let active = ["00000000000a", "00000000000b", "000000000001"];
+        let unverified = ["000000000002", "000000000004", "000000000003"];
+
+        let mut jobs = mixed();
+        order_jobs(&mut jobs, ListSort::Created);
+        let mut expected = [active, unverified].concat();
+        // Creation ascending; the creation tie at 20 is broken by ID.
+        expected.extend([
+            "00000000000c",
+            "00000000000d",
+            "00000000000e",
+            "00000000000f",
+        ]);
+        assert_eq!(ids(&jobs), expected);
+
+        let mut jobs = mixed();
+        order_jobs(&mut jobs, ListSort::Finished);
+        let mut expected = [active, unverified].concat();
+        // Newest finish first; the finish tie at 900 is broken by ID ascending.
+        // The unknown job's recent finish time never moves it into this group.
+        expected.extend([
+            "00000000000e",
+            "00000000000f",
+            "00000000000d",
+            "00000000000c",
+        ]);
+        assert_eq!(ids(&jobs), expected);
+
+        // The result is independent of the stored order.
+        for sort in [ListSort::Created, ListSort::Finished] {
+            let mut forward = mixed();
+            let mut reversed = mixed();
+            reversed.reverse();
+            order_jobs(&mut forward, sort);
+            order_jobs(&mut reversed, sort);
+            assert_eq!(ids(&forward), ids(&reversed));
+        }
+    }
+
+    #[test]
+    fn list_sort_reorders_without_changing_the_selected_jobs() {
+        let now = 1_000_000;
+        let mut jobs = vec![
+            job("000000000001", State::Running, 1, None),
+            job("000000000002", State::Unknown, 2, Some(now - 1)),
+            job("000000000003", State::Stopped, 3, None),
+            job("0000000000ff", State::Exited, 4, Some(now - 40_000)),
+        ];
+        for i in 0..8u64 {
+            // Creation ascending and finish descending are opposite orders.
+            jobs.push(job(
+                &format!("{:012x}", 0x10 + i),
+                State::Exited,
+                100 + i,
+                Some(now - 1_000 + i * 10),
+            ));
+        }
+        for all in [false, true] {
+            let mut plain = jobs.clone();
+            select_visible(&mut plain, all, now);
+            for sort in [ListSort::Created, ListSort::Finished] {
+                let mut sorted = jobs.clone();
+                select_visible(&mut sorted, all, now);
+                order_jobs(&mut sorted, sort);
+                assert_eq!(sorted.len(), plain.len());
+                assert_eq!(id_set(&sorted), id_set(&plain), "{all} {sort:?}");
+            }
+        }
+        let mut window = jobs.clone();
+        select_visible(&mut window, false, now);
+        order_jobs(&mut window, ListSort::Finished);
+        assert_eq!(
+            ids(&window),
+            [
+                "000000000001",
+                "000000000002",
+                "000000000003",
+                "000000000017",
+                "000000000016",
+                "000000000015",
+                "000000000014",
+                "000000000013",
+            ]
+        );
+    }
+
+    #[test]
+    fn list_without_sort_keeps_the_existing_order() {
+        let mut jobs = mixed();
+        select_visible(&mut jobs, true, 0);
+        // Group, then creation time; equal keys keep their stored order.
+        assert_eq!(
+            ids(&jobs),
+            [
+                "00000000000a",
+                "00000000000b",
+                "000000000001",
+                "000000000002",
+                "000000000004",
+                "000000000003",
+                "00000000000c",
+                "00000000000e",
+                "00000000000d",
+                "00000000000f",
+            ]
+        );
+    }
+
+    #[test]
+    fn list_sort_accepts_only_created_or_finished() {
+        fn parse(args: &[&str]) -> Result<Cli, clap::Error> {
+            Cli::try_parse_from([&["proclease", "list"][..], args].concat())
+        }
+        fn sort_of(args: &[&str]) -> Option<ListSort> {
+            match parse(args).unwrap().command {
+                Commands::List { sort, .. } => sort,
+                _ => unreachable!(),
+            }
+        }
+        assert_eq!(sort_of(&["--sort", "created"]), Some(ListSort::Created));
+        assert_eq!(sort_of(&["--sort", "finished"]), Some(ListSort::Finished));
+        assert_eq!(sort_of(&["--sort=created"]), Some(ListSort::Created));
+        assert_eq!(sort_of(&[]), None);
+        for bad in [
+            &["--sort", "Created"][..],
+            &["--sort", "finish"][..],
+            &["--sort", "created,finished"][..],
+            &["--sort", ""][..],
+            &["--sort"][..],
+        ] {
+            assert!(parse(bad).is_err(), "{bad:?}");
+        }
+        assert!(Cli::try_parse_from(["proclease", "watch", "--sort", "created"]).is_err());
+    }
 }
