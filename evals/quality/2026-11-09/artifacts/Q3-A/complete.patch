+impl Fixture {
+    /// Seed a supervisor-less record with an explicit state, creation time
+    /// and finish time (`None` records no finish time).
+    fn seed_sorted(
+        &self,
+        id: &str,
+        template: (&Value, &Value),
+        state: &str,
+        created: u64,
+        finished: Option<u64>,
+    ) {
+        let (record, launch) = template;
+        let mut record = record.clone();
+        let mut launch = launch.clone();
+        record["id"] = serde_json::json!(id);
+        record["state"] = serde_json::json!(state);
+        record["created_at_ms"] = serde_json::json!(created);
+        record["finished_at_ms"] = serde_json::json!(finished);
+        launch["id"] = serde_json::json!(id);
+        self.seed_files(
+            id,
+            &[
+                ("record.json", serde_json::to_vec(&record).unwrap()),
+                ("launch.json", serde_json::to_vec(&launch).unwrap()),
+            ],
+        );
+    }
+    /// The CLI without the `--json` flag that `command` adds.
+    fn human_command(&self, args: &[&str]) -> Command {
+        let mut cmd = Command::new(env!("CARGO_BIN_EXE_proclease"));
+        cmd.arg("--state-dir").arg(&self.state).args(args);
+        cmd
+    }
+    fn human_list(&self, args: &[&str]) -> String {
+        let output = self
+            .human_command(&[&["list", "--color", "never"][..], args].concat())
+            .env("COLUMNS", "160")
+            .output()
+            .unwrap();
+        assert!(output.status.success(), "{args:?}");
+        String::from_utf8(output.stdout).unwrap()
+    }
+}
+
+fn job_ids(value: &Value) -> Vec<String> {
+    value["jobs"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|job| job["id"].as_str().unwrap().to_owned())
+        .collect()
+}
+
+fn object_keys(value: &Value) -> Vec<String> {
+    let mut keys: Vec<_> = value.as_object().unwrap().keys().cloned().collect();
+    keys.sort();
+    keys
+}
