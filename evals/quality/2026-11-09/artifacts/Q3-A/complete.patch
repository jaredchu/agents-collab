+#[test]
+fn list_sort_orders_finished_jobs_after_active_and_unverified_jobs() {
+    let fixture = Fixture::new();
+    let (record, launch) = fixture.finished_template();
+    let template = (&record, &launch);
+    let mut active = Vec::new();
+    for _ in 0..2 {
+        let launched = fixture.call(&[
+            "run",
+            "--ttl",
+            "30s",
+            "--grace",
+            "100ms",
+            "--",
+            "/bin/sleep",
+            "30",
+        ]);
+        let job = &launched["job"];
+        let created = job["created_at_ms"].as_u64().unwrap();
+        active.push((created, job["id"].as_str().unwrap().to_owned()));
+    }
+    active.sort();
+    let now = now_ms();
+    let base = now - 7_200_000;
+    let seeds = [
+        // Unverified: creation order with an ID tie-break (b1/b2). The unknown
+        // job's recent finish time must not move it into finish-time order.
+        ("0000000000b2", "unknown", base + 5, Some(now - 1)),
+        ("0000000000b1", "stopped", base + 5, None),
+        ("0000000000b0", "unknown", base + 1, None),
+        // Finished, with a creation tie (a3/a4) and a finish tie (a1/a3).
+        ("0000000000a4", "expired", base + 20, Some(now - 70_000)),
+        ("0000000000a3", "failed", base + 20, Some(now - 50_000)),
+        ("0000000000a2", "stopped", base + 30, Some(now - 40_000)),
+        ("0000000000a1", "exited", base + 10, Some(now - 50_000)),
+    ];
+    for (id, state, created, finished) in seeds {
+        fixture.seed_sorted(id, template, state, created, finished);
+    }
+
+    let mut leading: Vec<String> = active.iter().map(|(_, id)| id.clone()).collect();
+    for id in ["0000000000b0", "0000000000b1", "0000000000b2"] {
+        leading.push(id.to_owned());
+    }
+    let expected = |finished: &[&str]| {
+        let mut ids = leading.clone();
+        ids.extend(finished.iter().map(|id| id.to_string()));
+        ids
+    };
+    let by_created = expected(&[
+        "0000000000a1",
+        "0000000000a3",
+        "0000000000a4",
+        "0000000000a2",
+    ]);
+    let by_finished = expected(&[
+        "0000000000a2",
+        "0000000000a1",
+        "0000000000a3",
+        "0000000000a4",
+    ]);
+
+    let records = |ids: &[String]| {
+        let mut bytes = Vec::new();
+        for id in ids {
+            let path = fixture.state.join(id).join("record.json");
+            bytes.push(fs::read(path).unwrap());
+        }
+        bytes
+    };
+    let seeded = &by_created[active.len()..];
+    let before = records(seeded);
+    let plain = fixture.call(&["list", "--all"]);
+    let plain_jobs = plain["jobs"].as_array().unwrap();
+    assert_eq!(plain_jobs.len(), by_created.len());
+    for (sort, expected) in [("created", &by_created), ("finished", &by_finished)] {
+        for extra in [&[][..], &["--resources"][..]] {
+            let args = [&["list", "--all", "--sort", sort][..], extra].concat();
+            let sorted = fixture.call(&args);
+            assert_eq!(&job_ids(&sorted), expected, "{args:?}");
+            assert_eq!(object_keys(&sorted), object_keys(&plain));
+            if extra.is_empty() {
+                // Same jobs with identical fields; only the order differs.
+                for job in sorted["jobs"].as_array().unwrap() {
+                    assert!(plain_jobs.contains(job), "{job}");
+                }
+            }
+        }
+        let text = fixture.human_list(&["--all", "--sort", sort]);
+        let mut last = None;
+        for id in expected {
+            let at = text.find(id.as_str()).expect(id);
+            assert!(Some(at) > last, "{sort}: {text}");
+            last = Some(at);
+        }
+    }
+    // Ordering is read-only: no record write and no lease renewal.
+    assert_eq!(records(seeded), before);
+    for (_, id) in &active {
+        let job = fixture.job(id);
+        let original = plain_jobs.iter().find(|j| j["id"] == id.as_str()).unwrap();
+        assert_eq!(job["expires_at_ms"], original["expires_at_ms"]);
+        assert_eq!(job["state"], "running");
+    }
+}
