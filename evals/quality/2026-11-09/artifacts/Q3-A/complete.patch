+#[test]
+fn list_sort_keeps_the_default_window_and_rejects_other_values() {
+    let fixture = Fixture::new();
+    let (record, launch) = fixture.finished_template();
+    let template = (&record, &launch);
+    let now = now_ms();
+    let base = now - 3_600_000;
+    for i in 1..=8u64 {
+        // Lower IDs finished more recently but were created later.
+        let id = format!("{i:012x}");
+        fixture.seed_sorted(&id, template, "exited", base - i, Some(now - i));
+    }
+    let extra = [
+        // c1 finished outside the 30-second window, so only --all shows it;
+        // c2 is unverified and always shown.
+        ("0000000000c1", "stopped", base, Some(now - 60_000)),
+        ("0000000000c2", "unknown", base + 1, Some(now)),
+    ];
+    for (id, state, created, finished) in extra {
+        fixture.seed_sorted(id, template, state, created, finished);
+    }
+    let window_finished = [
+        "0000000000c2",
+        "000000000001",
+        "000000000002",
+        "000000000003",
+        "000000000004",
+        "000000000005",
+    ];
+    let mut window_created = window_finished;
+    window_created[1..].reverse();
+    let mut window_set = window_finished;
+    window_set.sort();
+
+    let mut default = job_ids(&fixture.call(&["list"]));
+    default.sort();
+    assert_eq!(default, window_set);
+    let mut all = job_ids(&fixture.call(&["list", "--all"]));
+    all.sort();
+    assert_eq!(all.len(), 10);
+    for (sort, expected) in [("created", &window_created), ("finished", &window_finished)] {
+        let shown = job_ids(&fixture.call(&["list", "--sort", sort]));
+        assert_eq!(shown, *expected, "{sort}");
+        let mut shown = job_ids(&fixture.call(&["list", "--all", "--sort", sort]));
+        shown.sort();
+        assert_eq!(shown, all, "{sort}");
+    }
+
+    for bad in [
+        &["--sort", ""][..],
+        &["--sort", "Created"][..],
+        &["--sort", "FINISHED"][..],
+        &["--sort", "finish"][..],
+        &["--sort", "creation"][..],
+        &["--sort", "created,finished"][..],
+        &["--sort", "none"][..],
+        &["--sort"][..],
+    ] {
+        let args = [&["list"][..], bad].concat();
+        for json in [true, false] {
+            let mut command = if json {
+                fixture.command(&args)
+            } else {
+                fixture.human_command(&args)
+            };
+            let output = command.output().unwrap();
+            assert!(!output.status.success(), "{args:?}");
+            assert!(output.stdout.is_empty(), "{args:?}: job list printed");
+            assert!(!output.stderr.is_empty(), "{args:?}");
+        }
+    }
+    let output = fixture
+        .command(&["watch", "--once", "--sort", "created"])
+        .output()
+        .unwrap();
+    assert!(!output.status.success() && output.stdout.is_empty());
+}
